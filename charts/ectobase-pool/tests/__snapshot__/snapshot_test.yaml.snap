    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.20.1
      name: firewallpolicies.net.ectobase.dev
    spec:
      group: net.ectobase.dev
      names:
        kind: FirewallPolicy
        listKind: FirewallPolicyList
        plural: firewallpolicies
        shortNames:
          - fwpol
        singular: firewallpolicy
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: FirewallPolicy is a scaffold-only resource. Selector-based distributed firewall (§3.4).
              properties:
