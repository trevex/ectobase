  19: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: flowplane
        app.kubernetes.io/part-of: netplane
      name: flowplane-dpdk
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: flowplane
      template:
        metadata:
          labels:
            app.kubernetes.io/name: flowplane
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - |
                  set -e
                  UPLINK="eth1"
                  for i in $(seq 1 30); do
                    GW_MAC=$(ip -6 neigh show dev "$UPLINK" | grep -m1 router | grep -o 'lladdr [0-9a-f:]*' | cut -d' ' -f2 || true)
                    [ -n "$GW_MAC" ] && break
                    echo "waiting for fabric router neighbour on $UPLINK ($i)"; sleep 1
                  done
                  if [ -z "$GW_MAC" ]; then echo "FATAL: no fabric router neighbour on $UPLINK" >&2; exit 1; fi
                  echo "flowplane-dpdk wrapper: uplink=$UPLINK gateway_mac=$GW_MAC"
                  exec flowplane-dpdk serve \
                    --addr unix:///run/flowplane/dataplane.sock \
                    --uplink "$UPLINK" \
                    --gateway 169.254.0.1 \
                    --gateway-mac "$GW_MAC" \
                    --lcores "0-3" \
                    --backend nic
              command:
                - /bin/sh
                - -c
              image: ghcr.io/trevex/ectobase/flowplane-dpdk:dev
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 6
                initialDelaySeconds: 90
                periodSeconds: 10
                timeoutSeconds: 2
              name: flowplane-dpdk
              readinessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 40
                initialDelaySeconds: 2
                periodSeconds: 3
                timeoutSeconds: 2
              resources:
                limits:
                  hugepages-1Gi: 2Gi
                  intel.com/intel_sriov_netdevice: 1
                  memory: 2Gi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /sys
                  name: sys
                  readOnly: true
                - mountPath: /lib/modules
                  name: lib-modules
                  readOnly: true
                - mountPath: /var/run/netns
                  mountPropagation: Bidirectional
                  name: netns
                - mountPath: /run/flowplane
                  name: flowplane-sock
                - mountPath: /dev/vfio
                  name: vfio
                - mountPath: /dev/hugepages
                  name: hugepages
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          hostPID: true
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /sys
                type: Directory
              name: sys
            - hostPath:
                path: /lib/modules
                type: Directory
              name: lib-modules
            - hostPath:
                path: /var/run/netns
                type: DirectoryOrCreate
              name: netns
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
            - hostPath:
                path: /dev/vfio
                type: Directory
              name: vfio
            - emptyDir:
                medium: HugePages
              name: hugepages
