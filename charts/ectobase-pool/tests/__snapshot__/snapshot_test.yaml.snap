  22: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: flowplane
        app.kubernetes.io/part-of: mesh
      name: flowplane
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: flowplane
      template:
        metadata:
          labels:
            app.kubernetes.io/name: flowplane
            app.kubernetes.io/part-of: mesh
        spec:
          containers:
            - args:
                - |
                  set -e
                  UPLINK="${XDP_UPLINK:-eth1}"
                  for i in $(seq 1 30); do
                    GW_MAC=$(ip -6 neigh show dev "$UPLINK" | grep -m1 router | grep -o 'lladdr [0-9a-f:]*' | cut -d' ' -f2 || true)
                    [ -n "$GW_MAC" ] && break
                    echo "waiting for fabric router neighbour on $UPLINK ($i)"; sleep 1
                  done
                  if [ -z "$GW_MAC" ]; then echo "FATAL: no fabric router neighbour on $UPLINK" >&2; exit 1; fi
                  # Dual-homed fabric: also run uplink_rx on any OTHER up ethN (the second ToR uplink),
                  # so N-S returns arriving via either ToR (ECMP) are decapped. Primary/LOCAL = $UPLINK.
                  # eth0 is the clab-mgmt/docker iface (not fabric) — skip it; fabric uplinks are eth1+.
                  EXTRA=""
                  for d in $(ls /sys/class/net | grep -E '^eth[1-9][0-9]*$'); do
                    [ "$d" = "$UPLINK" ] && continue
                    [ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && EXTRA="$EXTRA --extra-uplink $d"
                  done
                  echo "flowplane wrapper: uplink=$UPLINK gateway_mac=$GW_MAC extra=[$EXTRA]"
                  exec flowplane serve --addr unix:///run/flowplane/dataplane.sock --uplink "$UPLINK" --gateway 169.254.0.1 --gateway-mac "$GW_MAC" $EXTRA
              command:
                - /bin/sh
                - -c
              image: ghcr.io/trevex/ectobase/flowplane:dev
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 6
                initialDelaySeconds: 90
                periodSeconds: 10
                timeoutSeconds: 2
              name: flowplane
              readinessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 40
                initialDelaySeconds: 2
                periodSeconds: 3
                timeoutSeconds: 2
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /sys/fs/bpf
                  mountPropagation: Bidirectional
                  name: bpf-fs
                - mountPath: /sys
                  name: sys
                  readOnly: true
                - mountPath: /lib/modules
                  name: lib-modules
                  readOnly: true
                - mountPath: /var/run/netns
                  mountPropagation: Bidirectional
                  name: netns
                - mountPath: /run/flowplane
                  name: flowplane-sock
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          hostPID: true
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
            - hostPath:
                path: /sys/fs/bpf
                type: DirectoryOrCreate
              name: bpf-fs
            - hostPath:
                path: /sys
                type: Directory
              name: sys
            - hostPath:
                path: /lib/modules
                type: Directory
              name: lib-modules
            - hostPath:
                path: /var/run/netns
                type: DirectoryOrCreate
              name: netns
  23: |
    apiVersion: k8s.cni.cncf.io/v1
    kind: NetworkAttachmentDefinition
    metadata:
      name: flowplane-overlay
      namespace: ectobase-system
    spec:
      config: |
        {
          "cniVersion": "1.0.0",
          "name": "flowplane-overlay",
          "plugins": [
            {
              "type": "flowplane-cni"
            }
          ]
        }
  24: |
    apiVersion: k8s.cni.cncf.io/v1
    kind: NetworkAttachmentDefinition
    metadata:
      name: flowplane
      namespace: ectobase-system
    spec:
      config: |
        {
          "cniVersion": "1.0.0",
          "name": "flowplane",
          "plugins": [
            {
              "type": "flowplane-cni",
              "deviceType": "pod-tap"
            }
          ]
        }
  25: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/name: pod-materializer
        app.kubernetes.io/part-of: mesh
      name: pod-materializer
      namespace: ectobase-system
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: pod-materializer
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/name: pod-materializer
            app.kubernetes.io/part-of: mesh
        spec:
          containers:
            - command:
                - pod-materializer
              image: ghcr.io/trevex/ectobase/mesh:dev
              imagePullPolicy: IfNotPresent
              name: pod-materializer
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
          serviceAccountName: pod-materializer
  26: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: mesh-agent
      namespace: ectobase-system
  27: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/part-of: ectobase
      name: mesh-agent
    rules:
      - apiGroups:
          - ""
        resources:
          - nodes
        verbs:
          - get
          - list
          - patch
          - watch
      - apiGroups:
          - ""
        resources:
          - secrets
        verbs:
          - get
          - list
          - watch
      - apiGroups:
          - cert-manager.io
        resources:
          - certificates
        verbs:
