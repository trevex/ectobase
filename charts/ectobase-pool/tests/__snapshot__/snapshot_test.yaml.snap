  19: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: flowplane
        app.kubernetes.io/part-of: netplane
      name: flowplane
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: flowplane
      template:
        metadata:
          labels:
            app.kubernetes.io/name: flowplane
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - |
                  set -e
                  UPLINK="${XDP_UPLINK:-eth1}"
                  for i in $(seq 1 30); do
                    GW_MAC=$(ip -6 neigh show dev "$UPLINK" | grep -m1 router | grep -o 'lladdr [0-9a-f:]*' | cut -d' ' -f2 || true)
                    [ -n "$GW_MAC" ] && break
                    echo "waiting for fabric router neighbour on $UPLINK ($i)"; sleep 1
                  done
                  if [ -z "$GW_MAC" ]; then echo "FATAL: no fabric router neighbour on $UPLINK" >&2; exit 1; fi
                  # Dual-homed fabric: also run uplink_rx on any OTHER up ethN (the second ToR uplink),
                  # so N-S returns arriving via either ToR (ECMP) are decapped. Primary/LOCAL = $UPLINK.
                  # eth0 is the kind/docker mgmt iface (not fabric) — skip it; fabric uplinks are eth1+.
                  EXTRA=""
                  for d in $(ls /sys/class/net | grep -E '^eth[1-9][0-9]*$'); do
                    [ "$d" = "$UPLINK" ] && continue
                    [ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && EXTRA="$EXTRA --extra-uplink $d"
                  done
                  echo "flowplane wrapper: uplink=$UPLINK gateway_mac=$GW_MAC extra=[$EXTRA]"
                  exec flowplane serve --addr unix:///run/flowplane/dataplane.sock --uplink "$UPLINK" --gateway 169.254.0.1 --gateway-mac "$GW_MAC" $EXTRA
              command:
                - /bin/sh
                - -c
              env:
                - name: FLOWPLANE_SKB_MODE
                  value: "1"
              image: ghcr.io/trevex/ectobase/flowplane:dev
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 6
                initialDelaySeconds: 90
                periodSeconds: 10
                timeoutSeconds: 2
              name: flowplane
              readinessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 40
                initialDelaySeconds: 2
                periodSeconds: 3
                timeoutSeconds: 2
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /sys/fs/bpf
                  mountPropagation: Bidirectional
                  name: bpf-fs
                - mountPath: /sys
                  name: sys
                  readOnly: true
                - mountPath: /lib/modules
                  name: lib-modules
                  readOnly: true
                - mountPath: /var/run/netns
                  mountPropagation: Bidirectional
                  name: netns
                - mountPath: /run/flowplane
                  name: flowplane-sock
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          hostPID: true
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
            - hostPath:
                path: /sys/fs/bpf
                type: DirectoryOrCreate
              name: bpf-fs
            - hostPath:
                path: /sys
                type: Directory
              name: sys
            - hostPath:
                path: /lib/modules
                type: Directory
              name: lib-modules
            - hostPath:
                path: /var/run/netns
                type: DirectoryOrCreate
              name: netns
