    spec:
      watchdogFilePath: /dev/watchdog
renders with vm-materializer enabled:
  1: |
    apiVersion: v1
    data:
      kubeconfig: |
        apiVersion: v1
        kind: Config
        clusters:
          - name: fabric
            cluster:
              server: https://[fd00:db8:0:1::1]:6443
              insecure-skip-tls-verify: true
        users:
          - name: sa
            user:
              tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
        contexts:
          - name: fabric
            context:
              cluster: fabric
              user: sa
        current-context: fabric
    kind: ConfigMap
    metadata:
      name: netplane-agent-kubeconfig
      namespace: ectobase-system
  2: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: netplane-agent
        app.kubernetes.io/part-of: netplane
      name: netplane-agent
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: netplane-agent
      template:
        metadata:
          labels:
            app.kubernetes.io/name: netplane-agent
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - --node-id=$(NODE_NAME)
                - --underlay=$(NODE_IP)
                - --reflector=[fd00:db8:0:1::1]:1338
                - --dataplane=unix:///run/flowplane/dataplane.sock
                - --kubeconfig=/etc/netplane/kubeconfig
              command:
                - agent
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
              image: ghcr.io/trevex/ectobase/netplane:dev
              imagePullPolicy: IfNotPresent
              name: agent
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /etc/netplane
                  name: kubeconfig
                  readOnly: true
                - mountPath: /run/flowplane
                  name: flowplane-sock
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          serviceAccountName: netplane-agent
          tolerations:
            - operator: Exists
          volumes:
            - configMap:
                name: netplane-agent-kubeconfig
              name: kubeconfig
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/name: dispatch-broker
        app.kubernetes.io/part-of: netplane
      name: dispatch-broker
      namespace: ectobase-system
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: dispatch-broker
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/name: dispatch-broker
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - --cluster-name=test
                - --dispatch-kubeconfig=/secrets/dispatch/kubeconfig
              command:
                - broker
              image: ghcr.io/trevex/ectobase/dispatch-broker:dev
              imagePullPolicy: IfNotPresent
              name: broker
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /secrets/dispatch
                  name: dispatch-kubeconfig
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          nodeSelector:
            node-role.kubernetes.io/control-plane: ""
          serviceAccountName: dispatch-broker
          tolerations:
            - operator: Exists
          volumes:
            - name: dispatch-kubeconfig
              secret:
                secretName: broker-dispatch-kubeconfig
  4: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: flowplane-cni
      namespace: ectobase-system
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/part-of: ectobase
      name: flowplane-cni
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - get
      - apiGroups:
          - compiled.ectobase.dev
        resources:
          - compilednics
        verbs:
          - get
  6: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: flowplane-cni
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: flowplane-cni
    subjects:
      - kind: ServiceAccount
        name: flowplane-cni
        namespace: ectobase-system
  7: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: flowplane-cni-install
        app.kubernetes.io/part-of: netplane
      name: flowplane-cni-install
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: flowplane-cni-install
      template:
        metadata:
          labels:
            app.kubernetes.io/name: flowplane-cni-install
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - image: ghcr.io/trevex/ectobase/cni:dev
              imagePullPolicy: IfNotPresent
              name: install
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                runAsUser: 0
              volumeMounts:
                - mountPath: /host/opt/cni/bin
                  name: cnibin
                - mountPath: /host/etc/cni/net.d
                  name: cniconf
          serviceAccountName: flowplane-cni
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /opt/cni/bin
              name: cnibin
            - hostPath:
                path: /etc/cni/net.d
              name: cniconf
  8: |
