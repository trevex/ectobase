renders (tier1 watchdog):
  1: |
    apiVersion: v1
    data:
      kubeconfig: |
        apiVersion: v1
        kind: Config
        clusters:
          - name: fabric
            cluster:
              server: https://[fd00:db8:0:1::1]:6443
              insecure-skip-tls-verify: true
        users:
          - name: sa
            user:
              tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
        contexts:
          - name: fabric
            context:
              cluster: fabric
              user: sa
        current-context: fabric
    kind: ConfigMap
    metadata:
      name: netplane-agent-kubeconfig
      namespace: ectobase-system
  2: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: netplane-agent
        app.kubernetes.io/part-of: netplane
      name: netplane-agent
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: netplane-agent
      template:
        metadata:
          labels:
            app.kubernetes.io/name: netplane-agent
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - --node-id=$(NODE_NAME)
                - --underlay=$(NODE_IP)
                - --reflector=[fd00:db8:0:1::1]:1338
                - --dataplane=unix:///run/flowplane/dataplane.sock
                - --kubeconfig=/etc/netplane/kubeconfig
              command:
                - agent
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
              image: ghcr.io/trevex/ectobase/netplane:dev
              imagePullPolicy: IfNotPresent
              name: agent
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /etc/netplane
                  name: kubeconfig
                  readOnly: true
                - mountPath: /run/flowplane
                  name: flowplane-sock
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          serviceAccountName: netplane-agent
          tolerations:
            - operator: Exists
          volumes:
            - configMap:
                name: netplane-agent-kubeconfig
              name: kubeconfig
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
