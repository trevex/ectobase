                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: NetworkInterfaceSpec is the desired state of a NetworkInterface (a thin NIC).
                  properties:
                    clusterName:
                      description: |-
                        ClusterName is the compute cluster this standalone (e.g. Pod) NIC targets. The
                        compiler uses it for placement (CompiledNIC.spec.clusterName) when no
                        VirtualMachine owns this NIC; an owning VM's placement takes precedence.
                      type: string
                    ips:
                      description: |-
                        IPs are the user-specified overlay IPs (v4 and/or v6). The platform does
                        not allocate these.
                      items:
                        type: string
                      type: array
                    mac:
                      description: |-
                        MAC is the interface's L2 address. REQUIRED for a KubeVirt VM (device_type
                        pod-tap/tap): the datapath programs this as the guest MAC, and the VMI's
                        spec.domain.devices.interfaces[].macAddress MUST be set to the same value so
                        KubeVirt gives the VM's virtio NIC that MAC. Empty for containers (derived).
                      type: string
                    nodeName:
                      description: NodeName is the node the interface is scheduled onto. Set by the scheduler.
                      type: string
                    qos:
                      description: QoS caps/shapes throughput for this interface. Nil = unlimited.
                      properties:
                        egress:
                          description: Egress shapes outbound (VM->out) throughput.
                          properties:
                            burstKB:
                              description: BurstKB is an optional burst allowance in KB. Reserved (EDT ignores it in v1). 0 = default.
                              format: int32
                              type: integer
                            publicMbps:
                              description: PublicMbps caps external/NATed egress in Mbit/s (policed). 0 = unlimited.
                              format: int32
                              type: integer
                            rateMbps:
                              description: RateMbps is the EDT-shaped total egress rate in Mbit/s. 0 = unlimited.
                              format: int32
                              type: integer
                          type: object
                        ingress:
                          description: Ingress polices inbound (out->VM) throughput.
                          properties:
                            burstKB:
                              description: BurstKB is an optional burst allowance in KB. Reserved (default burst in v1). 0 = default.
                              format: int32
                              type: integer
                            rateMbps:
                              description: RateMbps caps throughput in Mbit/s. 0 = unlimited.
                              format: int32
                              type: integer
                          type: object
                      type: object
                    vpcRef:
                      description: VPCRef references the VPC this interface belongs to.
                      properties:
                        name:
                          description: Name is the name of the referenced object.
                          type: string
                      required:
                        - name
                      type: object
                  required:
                    - vpcRef
                  type: object
                status:
                  description: NetworkInterfaceStatus is the observed state of a NetworkInterface.
                  properties:
                    port:
                      description: Port describes the dataplane port allocated for this interface.
                      properties:
                        name:
                          description: Name is the host-side interface name (e.g. dtapvf_0) for tap ports.
                          type: string
                        pciAddress:
                          description: PCIAddress is the PCI address for vf ports.
                          type: string
                        type:
                          description: Type is the port type (e.g. tap or vf).
                          enum:
                            - tap
                            - vf
                          type: string
                      type: object
                    state:
                      description: State is the current lifecycle state (e.g. Pending, Ready).
                      type: string
                    underlayRoute:
                      description: UnderlayRoute is the allocated underlay /128 from the host's underlay /64.
                      type: string
                    vni:
                      description: VNI is the effective VXLAN network identifier resolved from the VPC.
                      format: int32
                      type: integer
                  type: object
              type: object
          served: true
          storage: true
          subresources:
            status: {}
  17: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.20.1
      name: vpcpeerings.net.ectobase.dev
    spec:
      group: net.ectobase.dev
      names:
        kind: VPCPeering
        listKind: VPCPeeringList
        plural: vpcpeerings
        singular: vpcpeering
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: |-
                VPCPeering is one direction of a mutual-consent VPC peering; a reciprocal pair (A→B and B→A)
                forms an active peering. Reachability only — it grants no firewall permission.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: |-
                    VPCPeeringSpec is the desired state of a one-directional VPC peering. A mutual peering
                    is formed by a reciprocal pair (A→B and B→A). Reachability only — never a firewall grant.
                  properties:
                    exposedPrefixes:
                      description: |-
                        ExposedPrefixes is the CIDR allow-list THIS side offers to the peer: only local routes
                        within these CIDRs become reachable to the peer VPC. Empty = expose nothing (fail-closed).
                      items:
                        type: string
                      type: array
                    peerVpcRef:
                      description: PeerVPCRef references the other VPC (namespace + name).
                      properties:
                        name:
                          type: string
                        namespace:
                          type: string
                      required:
                        - name
                        - namespace
                      type: object
                    vpcRef:
                      description: VPCRef is this side's VPC (same namespace as this VPCPeering object).
                      properties:
                        name:
                          description: Name is the name of the referenced object.
                          type: string
                      required:
                        - name
                      type: object
                  required:
                    - peerVpcRef
                    - vpcRef
                  type: object
                status:
                  description: VPCPeeringStatus is the observed state of a VPCPeering.
                  properties:
                    message:
                      description: Message is a human-readable reason for the current State.
                      type: string
                    state:
                      description: |-
                        State is the peering lifecycle: Pending (awaiting the reciprocal), Ready (both sides
                        consent), or Invalid (validation failed).
                      type: string
                  type: object
              type: object
          served: true
          storage: true
          subresources:
            status: {}
  18: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.20.1
      name: vpcs.net.ectobase.dev
    spec:
      group: net.ectobase.dev
      names:
        kind: VPC
        listKind: VPCList
        plural: vpcs
        singular: vpc
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: VPC is an isolation domain (overlay network) identified by a VNI on the shared underlay.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: VPCSpec is the desired state of a VPC (an isolation domain / overlay network).
                  properties:
                    defaultPolicy:
                      description: |-
                        DefaultPolicy overrides the global default firewall posture for this VPC.
                        One of Allow (k8s semantics) or Deny (VPC-wide default-deny).
                      type: string
                    vni:
                      description: |-
                        VNI optionally pins the VXLAN network identifier. When nil or 0, the VNI is
                        allocated by the central cluster from the global VNI space.
                      format: int32
                      type: integer
                  type: object
                status:
                  description: VPCStatus is the observed state of a VPC.
                  properties:
                    state:
                      description: State is the current lifecycle state (e.g. Pending, Ready).
                      type: string
                    vni:
                      description: VNI is the effective, allocated VXLAN network identifier.
                      format: int32
                      type: integer
                  type: object
              type: object
          served: true
          storage: true
          subresources:
            status: {}
  19: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: flowplane
        app.kubernetes.io/part-of: netplane
      name: flowplane
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: flowplane
      template:
        metadata:
          labels:
            app.kubernetes.io/name: flowplane
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - |
                  set -e
                  UPLINK="${XDP_UPLINK:-eth1}"
                  for i in $(seq 1 30); do
                    GW_MAC=$(ip -6 neigh show dev "$UPLINK" | grep -m1 router | grep -o 'lladdr [0-9a-f:]*' | cut -d' ' -f2 || true)
                    [ -n "$GW_MAC" ] && break
                    echo "waiting for fabric router neighbour on $UPLINK ($i)"; sleep 1
                  done
                  if [ -z "$GW_MAC" ]; then echo "FATAL: no fabric router neighbour on $UPLINK" >&2; exit 1; fi
                  # Dual-homed fabric: also run uplink_rx on any OTHER up ethN (the second ToR uplink),
                  # so N-S returns arriving via either ToR (ECMP) are decapped. Primary/LOCAL = $UPLINK.
                  # eth0 is the kind/docker mgmt iface (not fabric) — skip it; fabric uplinks are eth1+.
                  EXTRA=""
                  for d in $(ls /sys/class/net | grep -E '^eth[1-9][0-9]*$'); do
                    [ "$d" = "$UPLINK" ] && continue
                    [ "$(cat /sys/class/net/$d/operstate 2>/dev/null)" = "up" ] && EXTRA="$EXTRA --extra-uplink $d"
                  done
                  echo "flowplane wrapper: uplink=$UPLINK gateway_mac=$GW_MAC extra=[$EXTRA]"
                  exec flowplane serve --addr unix:///run/flowplane/dataplane.sock --uplink "$UPLINK" --gateway 169.254.0.1 --gateway-mac "$GW_MAC" $EXTRA
              command:
                - /bin/sh
                - -c
              env:
                - name: FLOWPLANE_SKB_MODE
                  value: "1"
              image: ghcr.io/trevex/ectobase/flowplane:dev
              imagePullPolicy: IfNotPresent
              livenessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 6
                initialDelaySeconds: 90
                periodSeconds: 10
                timeoutSeconds: 2
              name: flowplane
              readinessProbe:
                exec:
                  command:
                    - /bin/sh
                    - -c
                    - test -S /run/flowplane/dataplane.sock
                failureThreshold: 40
                initialDelaySeconds: 2
                periodSeconds: 3
                timeoutSeconds: 2
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                privileged: true
              volumeMounts:
                - mountPath: /sys/fs/bpf
                  mountPropagation: Bidirectional
                  name: bpf-fs
                - mountPath: /sys
                  name: sys
                  readOnly: true
                - mountPath: /lib/modules
                  name: lib-modules
                  readOnly: true
                - mountPath: /var/run/netns
                  mountPropagation: Bidirectional
                  name: netns
                - mountPath: /run/flowplane
                  name: flowplane-sock
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          hostPID: true
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
            - hostPath:
                path: /sys/fs/bpf
                type: DirectoryOrCreate
              name: bpf-fs
            - hostPath:
                path: /sys
                type: Directory
              name: sys
            - hostPath:
                path: /lib/modules
                type: Directory
              name: lib-modules
            - hostPath:
                path: /var/run/netns
                type: DirectoryOrCreate
              name: netns
  20: |
    apiVersion: k8s.cni.cncf.io/v1
    kind: NetworkAttachmentDefinition
    metadata:
