renders (ebpf clab):
  1: |
    apiVersion: v1
    data:
      kubeconfig: |
        apiVersion: v1
        kind: Config
        clusters:
          - name: fabric
            cluster:
              server: https://[fd00:db8:0:1::1]:6443
              insecure-skip-tls-verify: true
        users:
          - name: sa
            user:
              tokenFile: /var/run/secrets/kubernetes.io/serviceaccount/token
        contexts:
          - name: fabric
            context:
              cluster: fabric
              user: sa
        current-context: fabric
    kind: ConfigMap
    metadata:
      name: mesh-agent-kubeconfig
      namespace: ectobase-system
  2: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: mesh-agent
        app.kubernetes.io/part-of: mesh
      name: mesh-agent
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: mesh-agent
      template:
        metadata:
          labels:
            app.kubernetes.io/name: mesh-agent
            app.kubernetes.io/part-of: mesh
        spec:
          containers:
            - args:
                - --node-id=$(NODE_NAME)
                - --underlay=$(NODE_IP)
                - --reflector=[fd00:db8:0:1::1]:1338
                - --dataplane=unix:///run/flowplane/dataplane.sock
                - --kubeconfig=/etc/mesh/kubeconfig
                - --tls-ca=/etc/routebus-root/ca.crt
                - --routebus-issuer=ectobase-pool-ca
                - --routebus-cert-namespace=ectobase-system
              command:
                - agent
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
              image: ghcr.io/trevex/ectobase/mesh:dev
              imagePullPolicy: IfNotPresent
              name: agent
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /etc/mesh
                  name: kubeconfig
                  readOnly: true
                - mountPath: /run/flowplane
                  name: flowplane-sock
                  readOnly: true
                - mountPath: /etc/routebus-root
                  name: routebus-root
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          serviceAccountName: mesh-agent
          tolerations:
            - operator: Exists
          volumes:
            - configMap:
                name: mesh-agent-kubeconfig
              name: kubeconfig
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
            - name: routebus-root
              secret:
                items:
                  - key: ca.crt
                    path: ca.crt
                secretName: ectobase-pool-ca
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/name: dispatch-broker
        app.kubernetes.io/part-of: mesh
      name: dispatch-broker
      namespace: ectobase-system
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: dispatch-broker
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/name: dispatch-broker
            app.kubernetes.io/part-of: mesh
        spec:
          containers:
            - args:
                - --cluster-name=test
                - --dispatch-server=https://[fd00:db8:0:1::1]:6444
                - --dispatch-ca=/secrets/dispatch-root/ca.crt
                - --dispatch-client-cert=/secrets/dispatch-cert/tls.crt
                - --dispatch-client-key=/secrets/dispatch-cert/tls.key
                - --dispatch-bootstrap-kubeconfig=/secrets/dispatch-bootstrap/kubeconfig
                - --routebus-intermediate-secret=ectobase-pool-ca
              command:
                - broker
              env:
                - name: POD_NAMESPACE
                  valueFrom:
                    fieldRef:
                      fieldPath: metadata.namespace
              image: ghcr.io/trevex/ectobase/dispatch-broker:dev
              imagePullPolicy: IfNotPresent
              name: broker
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /secrets/dispatch-cert
                  name: dispatch-cert
                  readOnly: true
                - mountPath: /secrets/dispatch-root
                  name: dispatch-root
                  readOnly: true
                - mountPath: /secrets/dispatch-bootstrap
                  name: dispatch-bootstrap
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          nodeSelector:
            node-role.kubernetes.io/control-plane: ""
          serviceAccountName: dispatch-broker
          tolerations:
            - operator: Exists
          volumes:
            - name: dispatch-cert
              secret:
                optional: true
                secretName: broker-dispatch-tls
            - name: dispatch-root
              secret:
                items:
                  - key: ca.crt
                    path: ca.crt
                secretName: dispatch-root-ca
            - name: dispatch-bootstrap
              secret:
                secretName: broker-dispatch-bootstrap
  4: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: flowplane-cni
      namespace: ectobase-system
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/part-of: ectobase
      name: flowplane-cni
    rules:
      - apiGroups:
          - ""
        resources:
          - pods
        verbs:
          - get
      - apiGroups:
          - compiled.ectobase.dev
        resources:
          - compilednics
        verbs:
          - get
          - list
  6: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRoleBinding
    metadata:
      name: flowplane-cni
    roleRef:
      apiGroup: rbac.authorization.k8s.io
      kind: ClusterRole
      name: flowplane-cni
    subjects:
      - kind: ServiceAccount
        name: flowplane-cni
        namespace: ectobase-system
  7: |
    apiVersion: apps/v1
    kind: DaemonSet
    metadata:
      labels:
        app.kubernetes.io/name: flowplane-cni-install
        app.kubernetes.io/part-of: mesh
      name: flowplane-cni-install
      namespace: ectobase-system
    spec:
      selector:
        matchLabels:
          app.kubernetes.io/name: flowplane-cni-install
      template:
        metadata:
          labels:
            app.kubernetes.io/name: flowplane-cni-install
            app.kubernetes.io/part-of: mesh
        spec:
          containers:
            - image: ghcr.io/trevex/ectobase/cni:dev
              imagePullPolicy: IfNotPresent
              name: install
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                runAsUser: 0
              volumeMounts:
                - mountPath: /host/opt/cni/bin
                  name: cnibin
                - mountPath: /host/etc/cni/net.d
                  name: cniconf
          serviceAccountName: flowplane-cni
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /opt/cni/bin
              name: cnibin
            - hostPath:
                path: /etc/cni/net.d
              name: cniconf
  8: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.20.1
      name: compiledcontainers.compiled.ectobase.dev
    spec:
      group: compiled.ectobase.dev
      names:
        kind: CompiledContainer
        listKind: CompiledContainerList
        plural: compiledcontainers
        singular: compiledcontainer
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: CompiledContainer is the lowered pod intent for a Container.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: |-
                    CompiledContainerSpec is the lowered, ready-to-materialize intent for a container workload: the pod
                    template + the cluster/node binding + the per-interface overlay wiring. A downstream pod-materializer
                    turns this into a v1.Pod.
                  properties:
                    args:
                      description: Args are the container args.
                      items:
                        type: string
                      type: array
                    clusterName:
                      description: ClusterName is the cluster this compiled container is bound to. The broker selects on this field.
                      type: string
                    command:
                      description: Command overrides the image entrypoint.
                      items:
                        type: string
                      type: array
                    env:
                      description: Env are the container environment variables.
                      items:
                        description: EnvVar represents an environment variable present in a Container.
                        properties:
                          name:
                            description: |-
                              Name of the environment variable.
                              May consist of any printable ASCII characters except '='.
                            type: string
                          value:
                            description: |-
                              Variable references $(VAR_NAME) are expanded
                              using the previously defined environment variables in the container and
                              any service environment variables. If a variable cannot be resolved,
                              the reference in the input string will be unchanged. Double $$ are reduced
                              to a single $, which allows for escaping the $(VAR_NAME) syntax: i.e.
                              "$$(VAR_NAME)" will produce the string literal "$(VAR_NAME)".
                              Escaped references will never be expanded, regardless of whether the variable
                              exists or not.
                              Defaults to "".
                            type: string
                          valueFrom:
                            description: Source for the environment variable's value. Cannot be used if value is not empty.
                            properties:
                              configMapKeyRef:
                                description: Selects a key of a ConfigMap.
                                properties:
                                  key:
                                    description: The key to select.
                                    type: string
                                  name:
                                    default: ""
                                    description: |-
                                      Name of the referent.
                                      This field is effectively required, but due to backwards compatibility is
                                      allowed to be empty. Instances of this type with an empty value here are
                                      almost certainly wrong.
                                      More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
                                    type: string
                                  optional:
                                    description: Specify whether the ConfigMap or its key must be defined
                                    type: boolean
                                required:
                                  - key
                                type: object
                                x-kubernetes-map-type: atomic
                              fieldRef:
                                description: |-
                                  Selects a field of the pod: supports metadata.name, metadata.namespace, `metadata.labels['<KEY>']`, `metadata.annotations['<KEY>']`,
                                  spec.nodeName, spec.serviceAccountName, status.hostIP, status.podIP, status.podIPs.
                                properties:
                                  apiVersion:
                                    description: Version of the schema the FieldPath is written in terms of, defaults to "v1".
                                    type: string
                                  fieldPath:
                                    description: Path of the field to select in the specified API version.
                                    type: string
                                required:
                                  - fieldPath
                                type: object
                                x-kubernetes-map-type: atomic
                              fileKeyRef:
                                description: |-
                                  FileKeyRef selects a key of the env file.
                                  Requires the EnvFiles feature gate to be enabled.
                                properties:
                                  key:
                                    description: |-
                                      The key within the env file. An invalid key will prevent the pod from starting.
                                      The keys defined within a source may consist of any printable ASCII characters except '='.
                                      During Alpha stage of the EnvFiles feature gate, the key size is limited to 128 characters.
                                    type: string
                                  optional:
                                    default: false
                                    description: |-
                                      Specify whether the file or its key must be defined. If the file or key
                                      does not exist, then the env var is not published.
                                      If optional is set to true and the specified key does not exist,
                                      the environment variable will not be set in the Pod's containers.

                                      If optional is set to false and the specified key does not exist,
                                      an error will be returned during Pod creation.
                                    type: boolean
                                  path:
                                    description: |-
                                      The path within the volume from which to select the file.
                                      Must be relative and may not contain the '..' path or start with '..'.
                                    type: string
                                  volumeName:
                                    description: The name of the volume mount containing the env file.
                                    type: string
                                required:
                                  - key
                                  - path
                                  - volumeName
                                type: object
                                x-kubernetes-map-type: atomic
                              resourceFieldRef:
                                description: |-
                                  Selects a resource of the container: only resources limits and requests
                                  (limits.cpu, limits.memory, limits.ephemeral-storage, requests.cpu, requests.memory and requests.ephemeral-storage) are currently supported.
                                properties:
                                  containerName:
                                    description: 'Container name: required for volumes, optional for env vars'
                                    type: string
                                  divisor:
                                    anyOf:
                                      - type: integer
                                      - type: string
                                    description: Specifies the output format of the exposed resources, defaults to "1"
                                    pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                                    x-kubernetes-int-or-string: true
                                  resource:
                                    description: 'Required: resource to select'
                                    type: string
                                required:
                                  - resource
                                type: object
                                x-kubernetes-map-type: atomic
                              secretKeyRef:
                                description: Selects a key of a secret in the pod's namespace
                                properties:
                                  key:
                                    description: The key of the secret to select from.  Must be a valid secret key.
                                    type: string
                                  name:
                                    default: ""
                                    description: |-
                                      Name of the referent.
                                      This field is effectively required, but due to backwards compatibility is
                                      allowed to be empty. Instances of this type with an empty value here are
                                      almost certainly wrong.
                                      More info: https://kubernetes.io/docs/concepts/overview/working-with-objects/names/#names
                                    type: string
                                  optional:
                                    description: Specify whether the Secret or its key must be defined
                                    type: boolean
                                required:
                                  - key
                                type: object
                                x-kubernetes-map-type: atomic
                            type: object
                        required:
                          - name
                        type: object
                      type: array
                    image:
                      description: Image is the container image.
                      type: string
                    interfaces:
                      description: Interfaces are the container's overlay interfaces (one per owned NetworkInterface).
                      items:
                        description: CompiledContainerInterface is a resolved overlay interface for a container.
                        properties:
                          mac:
                            description: MAC is the NetworkInterface's allocated L2 address (status.allocatedMAC, or a pinned spec.mac).
                            type: string
                          networkInterfaceRef:
                            description: |-
                              NetworkInterfaceRef is "<namespace>/<nic>" — the pod's net.ectobase.dev/network-interface
                              annotation, which flowplane-cni resolves to the CompiledNIC.
                            type: string
                          networkName:
                            description: NetworkName is the multus NetworkAttachmentDefinition name for the overlay binding.
                            type: string
                        type: object
                      type: array
                    nodeName:
                      description: NodeName is the pod nodeSelector (kubernetes.io/hostname).
                      type: string
                    resources:
                      description: Resources is the compute request/limit.
                      properties:
                        claims:
                          description: |-
                            Claims lists the names of resources, defined in spec.resourceClaims,
                            that are used by this container.

                            This field depends on the
                            DynamicResourceAllocation feature gate.

                            This field is immutable. It can only be set for containers.
                          items:
                            description: ResourceClaim references one entry in PodSpec.ResourceClaims.
                            properties:
                              name:
                                description: |-
                                  Name must match the name of one entry in pod.spec.resourceClaims of
                                  the Pod where this field is used. It makes that resource available
                                  inside a container.
                                type: string
                              request:
                                description: |-
                                  Request is the name chosen for a request in the referenced claim.
                                  If empty, everything from the claim is made available, otherwise
                                  only the result of this request.
                                type: string
                            required:
                              - name
                            type: object
                          type: array
                          x-kubernetes-list-map-keys:
                            - name
                          x-kubernetes-list-type: map
                        limits:
                          additionalProperties:
                            anyOf:
                              - type: integer
                              - type: string
                            pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                            x-kubernetes-int-or-string: true
                          description: |-
                            Limits describes the maximum amount of compute resources allowed.
                            More info: https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/
                          type: object
                        requests:
                          additionalProperties:
                            anyOf:
                              - type: integer
                              - type: string
                            pattern: ^(\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\+|-)?(([0-9]+(\.[0-9]*)?)|(\.[0-9]+))))?$
                            x-kubernetes-int-or-string: true
                          description: |-
                            Requests describes the minimum amount of compute resources required.
                            If Requests is omitted for a container, it defaults to Limits if that is explicitly specified,
                            otherwise to an implementation-defined value. Requests cannot exceed Limits.
                            More info: https://kubernetes.io/docs/concepts/configuration/manage-resources-containers/
                          type: object
                      type: object
                    restartPolicy:
                      description: RestartPolicy is the Pod restart policy.
                      type: string
                  type: object
                status:
                  description: CompiledContainerStatus is the observed state of a CompiledContainer.
                  properties:
                    state:
                      description: State is the materialization state (e.g. Applied, Pending).
                      type: string
                  type: object
              type: object
          served: true
          storage: true
          subresources:
            status: {}
  9: |
    apiVersion: apiextensions.k8s.io/v1
    kind: CustomResourceDefinition
    metadata:
      annotations:
        controller-gen.kubebuilder.io/version: v0.20.1
      name: compilednics.compiled.ectobase.dev
    spec:
      group: compiled.ectobase.dev
      names:
        kind: CompiledNIC
        listKind: CompiledNICList
        plural: compilednics
        singular: compilednic
      scope: Namespaced
      versions:
        - name: v1alpha1
          schema:
            openAPIV3Schema:
              description: |-
                CompiledNIC is a lowered, node-local bundle of all static per-NIC dataplane config.
                It is produced by the Compile() function from a NetworkInterface + matching NetworkPolicies.
              properties:
                apiVersion:
                  description: |-
                    APIVersion defines the versioned schema of this representation of an object.
                    Servers should convert recognized schemas to the latest internal value, and
                    may reject unrecognized values.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources
                  type: string
                kind:
                  description: |-
                    Kind is a string value representing the REST resource this object represents.
                    Servers may infer this from the endpoint the client submits requests to.
                    Cannot be updated.
                    In CamelCase.
                    More info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds
                  type: string
                metadata:
                  type: object
                spec:
                  description: |-
                    CompiledNICSpec is the fully lowered per-NIC STATIC POLICY the control plane hands to a node:
                    identity, VNI, overlay IPs, firewall rules (resolved from FirewallPolicy selectors), egress-SNAT
                    allocations, LB membership, and peer imports — derived from the NetworkInterface + VPC +
                    FirewallPolicy + LoadBalancer + NATGateway + VPCPeering so the agent never reads those directly.

                    The source NetworkInterface is recorded in the compiled.ectobase.dev/source-namespace and
                    /source-name annotations and encoded in the object name (<sourceNamespace>-<sourceName>) — so the
                    spec carries no NICRef. There is no ownerReference: the twin is written into a per-pool namespace
                    on the dispatch and Kubernetes forbids a cross-namespace owner, so teardown runs off a finalizer
                    on the NetworkInterface instead. It also deliberately does NOT carry
                    the NIC's underlay address: every interface on a node shares that node's one VTEP, which the
                    dataplane resolves at startup, and the agent obtains it from the local DataplaneNode
                    (ListInterfaces) to announce overlay routes with the correct node nexthop. Keeping node-local state out of this central object avoids a
                    compile->sync round-trip that would lag (and flap) the announced nexthop.
                  properties:
                    clusterName:
                      description: |-
                        ClusterName is the cluster this compiled NIC is bound to (the pod->node
                        binding). Set by the compiler from the owning VirtualMachine's placement,
                        or the compiler's --cluster-name default for NICs with no owning VM.
                        The per-cluster broker selects on this field.
                      type: string
                    firewall:
                      description: Firewall holds the compiled ingress and egress firewall rules.
                      properties:
                        egress:
                          description: Egress is the ordered list of egress firewall rules.
                          items:
                            description: CompiledFwRule is a single compiled firewall rule (peer CIDR + proto + port + action).
                            properties:
                              action:
                                description: 'Action is the rule action: "Allow" or "Deny".'
                                type: string
                              cidr:
                                description: |-
                                  CIDR is the peer CIDR to match: the SOURCE for an ingress rule, the DESTINATION for an egress
                                  rule ("0.0.0.0/0" = any IPv4, "::/0" = any IPv6).
                                type: string
                              endPort:
                                description: EndPort, when non-zero, extends Port to the inclusive destination-port range Port-EndPort.
                                format: int32
                                type: integer
                              icmpCode:
                                description: ICMPCode restricts the rule to one code of ICMPType (nil = any).
                                format: int32
                                type: integer
                              icmpType:
                                description: ICMPType restricts an ICMP rule to one message type of the CIDR's ICMP family (nil = any).
                                format: int32
                                type: integer
                              port:
                                description: Port is the destination port (0 = any).
                                format: int32
                                type: integer
                              proto:
                                description: Proto is the IP protocol ("TCP", "UDP", "ICMP", or "" for any).
                                type: string
                            required:
                              - action
                              - cidr
                            type: object
                          type: array
                        ingress:
                          description: Ingress is the ordered list of ingress firewall rules.
                          items:
                            description: CompiledFwRule is a single compiled firewall rule (peer CIDR + proto + port + action).
                            properties:
                              action:
                                description: 'Action is the rule action: "Allow" or "Deny".'
                                type: string
                              cidr:
                                description: |-
                                  CIDR is the peer CIDR to match: the SOURCE for an ingress rule, the DESTINATION for an egress
                                  rule ("0.0.0.0/0" = any IPv4, "::/0" = any IPv6).
                                type: string
                              endPort:
                                description: EndPort, when non-zero, extends Port to the inclusive destination-port range Port-EndPort.
                                format: int32
                                type: integer
                              icmpCode:
                                description: ICMPCode restricts the rule to one code of ICMPType (nil = any).
                                format: int32
                                type: integer
                              icmpType:
                                description: ICMPType restricts an ICMP rule to one message type of the CIDR's ICMP family (nil = any).
                                format: int32
                                type: integer
                              port:
                                description: Port is the destination port (0 = any).
                                format: int32
                                type: integer
                              proto:
                                description: Proto is the IP protocol ("TCP", "UDP", "ICMP", or "" for any).
                                type: string
                            required:
                              - action
                              - cidr
                            type: object
                          type: array
                      type: object
                    lb:
                      description: |-
                        LB lists the load balancers this NIC is a backend of. Pure forwarding membership —
                        it grants NO firewall permission (that comes solely from FirewallPolicy).
                      items:
                        description: 'CompiledLB is one load-balancer this NIC backs: the LB address (v4 or v6) and its service ports.'
                        properties:
                          ip:
                            description: LB address is the load-balancer virtual IP (IPv4 or IPv6).
                            type: string
                          ports:
                            description: Ports are the LB service (port, proto) tuples.
                            items:
                              description: CompiledLBPort is one LB service tuple.
                              properties:
                                port:
                                  format: int32
                                  type: integer
                                proto:
                                  type: string
                              required:
                                - port
                                - proto
                              type: object
                            type: array
                        required:
                          - ip
                        type: object
                      type: array
                    mac:
                      description: |-
                        MAC is the guest L2 address sourced from the NetworkInterface's allocation
                        (status.allocatedMAC, or a pinned spec.mac adopted into it). The CNI programs it as the
                        datapath guest MAC, and it is also the key a KubeVirt virt-launcher pod's interface is
                        resolved by, since that pod carries no network-interface annotation.
                      type: string
                    nat:
                      description: |-
                        NAT lists the egress-SNAT sources for this NIC's overlay IPs — one entry per NATGateway
                        allocation whose source is one of this NIC's IPs. Empty if the NIC's VPC has no NAT gateway.
                      items:
                        description: |-
                          CompiledNATSource is one egress-SNAT mapping: an overlay source IP SNATed onto a public NAT IP
                          and source-port range. It corresponds to a single NATGateway allocation for one of the NIC's IPs.
                        properties:
                          natIP:
                            description: NATIP is the public NAT IPv4 address.
                            type: string
                          portMax:
                            description: PortMax is the end of the source-port range (inclusive).
                            format: int32
                            type: integer
                          portMin:
                            description: PortMin is the start of the source-port range (inclusive).
                            format: int32
                            type: integer
                          sourceIP:
                            description: SourceIP is the overlay IP being SNATed (one of the NIC's OverlayIPs).
                            type: string
                        required:
                          - natIP
                          - portMax
                          - portMin
                          - sourceIP
                        type: object
                      type: array
                    overlayIPs:
                      description: OverlayIPs are the guest overlay IP addresses.
                      items:
                        type: string
                      type: array
                    peerImports:
                      description: |-
                        PeerImports lists peer VPCs whose routes this NIC imports (reachability only — grants NO
                        firewall permission; that comes solely from FirewallPolicy). Populated from Ready VPCPeerings
                        involving this NIC's VPC.
                      items:
                        description: CompiledPeerImport is one peer VPC's reachability import for a NIC.
                        properties:
                          importPrefixes:
                            description: |-
                              ImportPrefixes is the peer's exposedPrefixes: only peer routes within these CIDRs are
                              imported (filter applied importer-side).
                            items:
                              type: string
                            type: array
                          peerVni:
                            description: PeerVNI is the peer VPC's VNI to subscribe to on routebus.
                            format: int32
                            type: integer
                        required:
                          - peerVni
                        type: object
                      type: array
                    port:
                      description: Port describes the dataplane port allocated for this interface.
                      properties:
                        name:
                          description: Name is the host-side interface name (e.g. dtapvf_0) for tap ports.
                          type: string
                        pciAddress:
                          description: PCIAddress is the PCI address for vf ports.
                          type: string
                        type:
                          description: Type is the port type (e.g. tap or vf).
                          enum:
                            - tap
                            - vf
                          type: string
                      type: object
                    qos:
                      description: QoS is the flattened per-interface QoS caps to program, or nil for unlimited.
                      properties:
                        egressMbps:
                          description: EgressMbps is the total egress EDT shaping cap (0 = unlimited).
                          format: int32
                          type: integer
                        ingressMbps:
                          description: IngressMbps is the token-bucket policing cap on ingress (0 = unlimited).
                          format: int32
                          type: integer
                        publicMbps:
                          description: PublicMbps caps external/NATed egress only (0 = unlimited).
                          format: int32
                          type: integer
                      type: object
                    vni:
                      description: |-
                        VNI is the effective VXLAN network identifier for this NIC (resolved from the NIC's
                        status.vni, falling back to its VPC's status.vni).
                      format: int32
                      type: integer
                  required:
                    - firewall
