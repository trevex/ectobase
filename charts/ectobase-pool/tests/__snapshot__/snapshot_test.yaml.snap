      - kind: ServiceAccount
        name: pod-materializer
        namespace: ectobase-system
  31: |
    apiVersion: remediation.medik8s.io/v1alpha1
    kind: NodeHealthCheck
    metadata:
      labels:
        app.kubernetes.io/part-of: ectobase
      name: ectobase-tier1
    spec:
      minHealthy: 51%
      remediationTemplate:
        apiVersion: self-node-remediation.medik8s.io/v1alpha1
        kind: SelfNodeRemediationTemplate
        name: ectobase-tier1
        namespace: self-node-remediation
      selector:
        matchExpressions:
          - key: node-role.kubernetes.io/control-plane
            operator: DoesNotExist
      unhealthyConditions:
        - duration: 60s
          status: "False"
          type: Ready
        - duration: 60s
          status: Unknown
          type: Ready
  32: |
    apiVersion: self-node-remediation.medik8s.io/v1alpha1
    kind: SelfNodeRemediationTemplate
    metadata:
      labels:
        app.kubernetes.io/part-of: ectobase
      name: ectobase-tier1
      namespace: self-node-remediation
    spec:
      template:
        spec:
          remediationStrategy: OutOfServiceTaint
  33: |
    apiVersion: self-node-remediation.medik8s.io/v1alpha1
    kind: SelfNodeRemediationConfig
    metadata:
      labels:
        app.kubernetes.io/part-of: ectobase
      name: self-node-remediation-config
