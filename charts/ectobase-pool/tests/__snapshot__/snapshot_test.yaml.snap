                - --node-id=$(NODE_NAME)
                - --underlay=$(NODE_IP)
                - --reflector=[fd00:db8:0:1::1]:1338
                - --dataplane=unix:///run/flowplane/dataplane.sock
                - --kubeconfig=/etc/netplane/kubeconfig
              command:
                - agent
              env:
                - name: NODE_NAME
                  valueFrom:
                    fieldRef:
                      fieldPath: spec.nodeName
                - name: NODE_IP
                  valueFrom:
                    fieldRef:
                      fieldPath: status.hostIP
              image: ghcr.io/trevex/ectobase/netplane:dev
              imagePullPolicy: IfNotPresent
              name: agent
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /etc/netplane
                  name: kubeconfig
                  readOnly: true
                - mountPath: /run/flowplane
                  name: flowplane-sock
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          serviceAccountName: netplane-agent
          tolerations:
            - operator: Exists
          volumes:
            - configMap:
                name: netplane-agent-kubeconfig
              name: kubeconfig
            - hostPath:
                path: /run/flowplane
                type: DirectoryOrCreate
              name: flowplane-sock
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/name: dispatch-broker
        app.kubernetes.io/part-of: netplane
      name: dispatch-broker
      namespace: ectobase-system
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: dispatch-broker
      strategy:
        type: Recreate
      template:
        metadata:
          labels:
            app.kubernetes.io/name: dispatch-broker
            app.kubernetes.io/part-of: netplane
        spec:
          containers:
            - args:
                - --cluster-name=test
                - --dispatch-kubeconfig=/secrets/dispatch/kubeconfig
              command:
                - broker
              image: ghcr.io/trevex/ectobase/dispatch-broker:dev
              imagePullPolicy: IfNotPresent
              name: broker
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              volumeMounts:
                - mountPath: /secrets/dispatch
                  name: dispatch-kubeconfig
                  readOnly: true
          dnsPolicy: ClusterFirstWithHostNet
          hostNetwork: true
          nodeSelector:
            node-role.kubernetes.io/control-plane: ""
          serviceAccountName: dispatch-broker
          tolerations:
            - operator: Exists
          volumes:
            - name: dispatch-kubeconfig
              secret:
                secretName: broker-dispatch-kubeconfig
  4: |
    apiVersion: v1
    kind: ServiceAccount
    metadata:
      name: flowplane-cni
      namespace: ectobase-system
  5: |
    apiVersion: rbac.authorization.k8s.io/v1
    kind: ClusterRole
    metadata:
      labels:
        app.kubernetes.io/managed-by: Helm
