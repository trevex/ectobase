                      format: int32
                      type: integer
                    state:
                      description: 'State is the current lifecycle state: Pending, Ready, Invalid or Conflict.'
                      type: string
                    total:
                      description: Total is the number of allocatable addresses across this pool's prefixes.
                      format: int32
                      type: integer
                  type: object
              type: object
