              name: install
              resources:
                requests:
                  cpu: 50m
                  memory: 64Mi
              securityContext:
                runAsUser: 0
              volumeMounts:
                - mountPath: /host/opt/cni/bin
                  name: cnibin
                - mountPath: /host/etc/cni/net.d
                  name: cniconf
          serviceAccountName: flowplane-cni
          tolerations:
            - operator: Exists
          volumes:
            - hostPath:
                path: /opt/cni/bin
              name: cnibin
            - hostPath:
                path: /etc/cni/net.d
              name: cniconf
  8: |
