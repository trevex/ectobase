                      description: PoolRef is the IPPool this address came from.
                      properties:
                        name:
                          description: Name is the name of the referenced object.
                          type: string
                      required:
                        - name
                      type: object
                  required:
                    - address
                    - consumerRef
                    - poolRef
                  type: object
              type: object
          served: true
          storage: true
