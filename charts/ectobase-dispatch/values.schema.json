{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["namespace", "agentNamespace", "reflectorAdmin"],
  "additionalProperties": true,
  "properties": {
    "namespace": {
      "type": "string",
      "description": "Namespace for dispatch infrastructure (apiserver, controller, kine, broker identity).",
      "minLength": 1
    },
    "agentNamespace": {
      "type": "string",
      "description": "Namespace for the mesh compiler and reflector.",
      "minLength": 1
    },
    "reflectorAdmin": {
      "type": "string",
      "description": "Address passed to dispatch-controller via -reflector-admin.",
      "minLength": 1
    },
    "pki": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "fleetIdentities": {
          "type": "array",
          "description": "RouteBusIdentity names that are not pools (e.g. edge); the signer constrains them to their own spec.permittedUnderlayCIDRs. Empty trusts none.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          }
        }
      }
    },
    "imagePullPolicy": {
      "type": "string",
      "enum": ["Always", "IfNotPresent", "Never"]
    },
    "postgres": {
      "type": "object",
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Where postgres keeps its data: pvc, hostPath, or emptyDir (loses all dispatch state on every pod restart).",
              "enum": ["pvc", "hostPath", "emptyDir"]
            },
            "storageClass": {"type": "string"},
            "size": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "images": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dispatchApiserver": {"type": "string"},
        "dispatchController": {"type": "string"},
        "mesh": {"type": "string"},
        "kine": {"type": "string"},
        "postgres": {"type": "string"}
      }
    }
  }
}
