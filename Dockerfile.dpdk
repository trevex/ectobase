# syntax=docker/dockerfile:1
#
# Container image for the `flowplane-dpdk` DPDK datapath binary.
#
# Unlike the eBPF `flowplane` image (Dockerfile), this binary links a from-source DPDK build:
# `dpdk-sys/build.rs` downloads DPDK 25.11.2 and builds it (meson/ninja) with a minimal PMD set
# (net/null,net/pcap,net/tap,net/af_xdp), statically, at `cargo build` time. That build is SLOW
# (several minutes) and pulls native deps — hence the fat builder stage below.
#
#   * DPDK core is linked STATICALLY (--default-library=static), so it is baked into the binary.
#   * A handful of libs stay DYNAMIC and MUST be present in the runtime image, or EAL init fails:
#     libnuma (DPDK core), libpcap (net/pcap PMD), libbpf + libxdp (net/af_xdp PMD), and the
#     transitive closure of those (libelf, libz, libzstd, liblzma, libbz2, libnl-3, libnl-genl-3).
#     Determined from `ldd target/release/flowplane-dpdk` (see the runtime stage comment).
#
# Toolchain: the repo's pinned nightly (rust-toolchain.toml). No LLVM/bpf-linker is needed here —
# there is no eBPF object in this binary. protobuf-compiler is required because flowplane-dpdk's
# build.rs runs tonic-build over the dataplane proto (same server surface as the eBPF binary).

# ---------------------------------------------------------------------------
# Builder
# ---------------------------------------------------------------------------
FROM debian:bookworm AS builder

ENV DEBIAN_FRONTEND=noninteractive

# Build tooling for the from-source DPDK + the Rust release build:
#   * meson/ninja-build/python3-pyelftools  -> DPDK's meson build system.
#   * libnuma-dev                           -> DPDK core (numa-aware memory).
#   * libbpf-dev/libxdp-dev                  -> net/af_xdp PMD.
#   * libpcap-dev                            -> net/pcap PMD.
#   * clang/libclang-dev/llvm-dev            -> bindgen (dpdk-sys generates DPDK FFI bindings).
#   * protobuf-compiler                      -> tonic-build (flowplane-dpdk build.rs proto compile).
#   * pkg-config/build-essential/git/curl/ca-certificates -> baseline build + rustup fetch.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl git \
        build-essential pkg-config \
        meson ninja-build python3-pyelftools \
        libnuma-dev \
        clang libclang-dev llvm-dev \
        libbpf-dev libxdp-dev libelf-dev \
        libpcap-dev \
        protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/root/.cargo/bin:${PATH}

# rustup honors rust-toolchain.toml (pinned nightly) at the first cargo invocation in /src.
RUN curl --proto '=https' --tlsv1.2 -fsSL https://sh.rustup.rs \
        | sh -s -- -y --default-toolchain none --profile minimal

# Escape hatch mirroring dpdk-sys/build.rs: if DPDK_PREFIX is set to a NON-EMPTY path, the
# multi-minute DPDK download+build is skipped and the prebuilt prefix is linked instead. CI can
# point this at a cached prefix (restored into the build context / a mounted cache) to save build
# time. Empty (the default) -> build.rs builds DPDK from source. build.rs treats an empty value as
# unset, so the `ARG DPDK_PREFIX=` default leaking into the env as "" is handled correctly there.
ARG DPDK_PREFIX=
ENV DPDK_PREFIX=${DPDK_PREFIX}

WORKDIR /src
COPY . .

# Release build of just the DPDK host binary. dpdk-sys/build.rs builds DPDK from source (when
# DPDK_PREFIX is empty/unset) then flowplane-dpdk links it statically.
RUN cargo build --release -p flowplane-dpdk \
    && cp target/release/flowplane-dpdk /flowplane-dpdk \
    && strip /flowplane-dpdk

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# debian:bookworm-slim (matches the builder's glibc). DPDK core is static, but the binary still
# dynamically links the libs below. The list is the `ldd target/release/flowplane-dpdk` closure
# minus the glibc base (libc/libm/libpthread/libgcc_s/ld-linux, already in the base image):
#
#   libnuma.so.1        -> libnuma1        (DPDK core)
#   libpcap.so.1        -> libpcap0.8      (net/pcap PMD)
#   libbpf.so.1         -> libbpf1         (net/af_xdp PMD)
#   libxdp.so.1         -> libxdp1         (net/af_xdp PMD)
#   libnl-3.so.200      -> libnl-3-200     (via libxdp/af_xdp)
#   libnl-genl-3.so.200 -> libnl-genl-3-200(via libxdp/af_xdp)
#   libelf.so.1         -> libelf1         (via libbpf)
#   libz.so.1           -> zlib1g          (via libelf/libpcap)
#   libzstd.so.1        -> libzstd1        (via libelf)
#   liblzma.so.5        -> liblzma5        (via libelf)
#   libbz2.so.1         -> libbz2-1.0      (via libpcap)
#   libatomic.so.1      -> libatomic1      (DPDK atomics)
#
# Most transitive libs are Depends of the primary libs; they are listed explicitly so a missing
# apt Depends can never leave the runtime image short a .so (a missing .so = EAL init crash).
#
# iproute2 + ethtool mirror the eBPF image: veth/tap/netns setup and the af_xdp init container
# (`ip tuntap add ...` to create kernel taps for the net_tap PMD) run from this same image.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 ethtool \
        libnuma1 libpcap0.8 libbpf1 libxdp1 \
        libnl-3-200 libnl-genl-3-200 \
        libelf1 zlib1g libzstd1 liblzma5 libbz2-1.0 libatomic1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /flowplane-dpdk /usr/local/bin/flowplane-dpdk

ENTRYPOINT ["/usr/local/bin/flowplane-dpdk"]
