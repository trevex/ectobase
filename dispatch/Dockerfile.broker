#
# Minimal runtime image for the per-cluster broker (kubelet-analog). See
# Dockerfile.apiserver for why the binary is built on the host and COPYd in
# (local `replace` in go.mod).
#
# Expects: a statically linked `dispatch-broker` binary next to this file.
FROM gcr.io/distroless/static:nonroot
COPY dispatch-broker /usr/local/bin/broker
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/broker"]
