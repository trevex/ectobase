#
# Minimal runtime image for the hub aggregated apiserver. The binary is
# built on the host (see hub/hack/smoke.sh) rather than inside the image,
# because hub/go.mod carries a local `replace go.opendefense.cloud/kit =>
# /home/nik/Development/apiserver-kit` that points OUTSIDE the module tree and so
# is not reachable from a Docker build context. Once apiserver-kit is published
# at a fixed version (drop the replace), this can become a standard multi-stage
# `FROM golang ... go build` image.
#
# Expects: a statically linked `hub-apiserver` binary next to this file.
FROM gcr.io/distroless/static:nonroot
COPY hub-apiserver /usr/local/bin/hub-apiserver
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/hub-apiserver"]
