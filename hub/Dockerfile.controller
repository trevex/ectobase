#
# Minimal runtime image for the hub controller. See Dockerfile.apiserver for
# why the binary is built on the host and COPYd in (local `replace` in go.mod).
#
# Expects: a statically linked `hub-controller` binary next to this file.
FROM gcr.io/distroless/static:nonroot
COPY hub-controller /usr/local/bin/hub-controller
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/hub-controller"]
