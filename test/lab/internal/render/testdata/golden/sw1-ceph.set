set system host-name 'sw1'
set service ssh
set system login user admin authentication plaintext-password 'admin'
set protocols bgp system-as '65010'
set protocols bgp parameters router-id '10.0.1.1'
set protocols bgp parameters bestpath as-path multipath-relax
set protocols bgp address-family ipv6-unicast maximum-paths ebgp '64'
set protocols bgp peer-group edges remote-as 'external'
set protocols bgp peer-group edges capability extended-nexthop
set protocols bgp peer-group edges bfd
set protocols bgp peer-group edges address-family ipv6-unicast
set protocols bgp neighbor eth1 interface v6only peer-group 'edges'
set protocols bgp neighbor eth2 interface v6only peer-group 'edges'
set protocols bgp peer-group hosts remote-as 'external'
set protocols bgp peer-group hosts capability extended-nexthop
set protocols bgp peer-group hosts address-family ipv6-unicast as-override
set protocols bgp neighbor eth3 interface v6only peer-group 'hosts'
set protocols static route6 fd00:db8:1:1::/64 interface eth3
set protocols bgp address-family ipv6-unicast network 'fd00:db8:1:1::/64'
set protocols static route6 fd00:cafe:64ec::/64 next-hop fd00:cafe:64ec::1
set protocols bgp address-family ipv6-unicast network 'fd00:cafe:64ec::/64'
set service router-advert interface eth3 prefix fd00:db8:1:1::/64
set service router-advert interface eth3 name-server 'fd00:ffff::e1'
set service router-advert interface eth3 name-server 'fd00:ffff::e2'
set protocols bgp neighbor eth4 interface v6only peer-group 'hosts'
set protocols static route6 fd00:db8:1:2::/64 interface eth4
set protocols bgp address-family ipv6-unicast network 'fd00:db8:1:2::/64'
set protocols static route6 fd00:cafe:1914::/64 next-hop fd00:cafe:1914::1
set protocols bgp address-family ipv6-unicast network 'fd00:cafe:1914::/64'
set service router-advert interface eth4 prefix fd00:db8:1:2::/64
set service router-advert interface eth4 name-server 'fd00:ffff::e1'
set service router-advert interface eth4 name-server 'fd00:ffff::e2'
set protocols bgp neighbor eth5 interface v6only peer-group 'hosts'
set protocols static route6 fd00:db8:1:3::/64 interface eth5
set protocols bgp address-family ipv6-unicast network 'fd00:db8:1:3::/64'
set protocols static route6 fd00:cafe:1914::/64 next-hop fd00:cafe:1914::2
set protocols bgp address-family ipv6-unicast network 'fd00:cafe:1914::/64'
set service router-advert interface eth5 prefix fd00:db8:1:3::/64
set service router-advert interface eth5 name-server 'fd00:ffff::e1'
set service router-advert interface eth5 name-server 'fd00:ffff::e2'
set protocols bgp neighbor eth6 interface v6only peer-group 'hosts'
set protocols static route6 fd00:db8:1:4::/64 interface eth6
set protocols bgp address-family ipv6-unicast network 'fd00:db8:1:4::/64'
set service router-advert interface eth6 prefix fd00:db8:1:4::/64
set service router-advert interface eth6 name-server 'fd00:ffff::e1'
set service router-advert interface eth6 name-server 'fd00:ffff::e2'
