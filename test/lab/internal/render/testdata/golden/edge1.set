set system host-name 'edge1'
set service ssh
set system login user admin authentication plaintext-password 'admin'
set interfaces dummy dum0 address 'fd00:ffff::e1/128'
set interfaces ethernet eth3 address 'fd00:29::11/64'
set interfaces ethernet eth4 address 'fd00:64:1::1/64'
set protocols static route6 ::/0 next-hop 'fd00:29::1'
set protocols static route6 64:ff9b::/96 next-hop 'fd00:64:1::2'
set protocols bgp system-as '65000'
set protocols bgp parameters router-id '10.0.0.1'
set protocols bgp parameters bestpath as-path multipath-relax
set protocols bgp address-family ipv6-unicast maximum-paths ebgp '64'
set protocols bgp address-family ipv6-unicast network 'fd00:ffff::e1/128'
set protocols bgp address-family ipv6-unicast network '64:ff9b::/96'
set protocols bgp peer-group fabric remote-as 'external'
set protocols bgp peer-group fabric capability extended-nexthop
set protocols bgp peer-group fabric bfd
set protocols bgp peer-group fabric address-family ipv6-unicast default-originate
set protocols bgp neighbor eth1 interface v6only peer-group 'fabric'
set protocols bgp neighbor eth2 interface v6only peer-group 'fabric'
set service dns forwarding dns64-prefix '64:ff9b::/96'
set service dns forwarding listen-address 'fd00:ffff::e1'
set service dns forwarding allow-from 'fd00:cafe::/32'
set service dns forwarding allow-from 'fd00:db8::/32'
set service dns forwarding allow-from 'fd00:ffff::/32'
set service dns forwarding name-server '2606:4700:4700::1111'
