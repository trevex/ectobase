# Generated from templates/fabric.clab.yml.tmpl — do not edit by hand.
name: {{ .Name }}

mgmt:
  network: {{ .Name }}-mgmt
  # P3b/mgmt-drop: every fabric router (edge/switch) AND every Talos compute node is
  # detached from mgmt via a per-node network-mode override below (no eth0 at all —
  # fabric-only egress by construction, no mgmt default to leak past the fabric
  # RA/BGP default). The mgmt net still exists only for the registry's published
  # host port + other infra that isn't part of the fabric-only model. With no
  # clab-mgmt on the Talos nodes, the harness has no mgmt-IP path to them either: the
  # host reaches the fabric itself via the WAN-segment jump veth (below, for
  # fabric-dependent calls like Cilium install / node-ready waits), and reaches a
  # given node's Talos API / kubectl directly and fabric-independently via `nsenter
  # -t <container-pid> -n` into that node's own network namespace (talos.Bootstrap,
  # deploy.WaitAPIServer) — its /128 (and, for a single-CP cluster, the anycast API
  # VIP) is on-link inside that netns regardless of what the fabric is doing.

topology:
  defaults:
    env:
      TZ: UTC

  nodes:
    edge1:
      kind: linux
      image: {{ index .Images "vyos" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      # vyos-router runs this as a vbash script on every boot (BGP+DNS64+NAT64-routes);
      # config.boot itself stays the image's stock default.
      binds:
        - vyos/edge1.set:/opt/vyatta/etc/config/scripts/vyos-postconfig-bootup.script
      sysctls: {net.ipv6.conf.all.forwarding: 1}
    # flowplane N/S-LB edge sidecar (B10): shares edge1's netns (network-mode names
    # the real docker container, clab-<lab>-edge1 — the same container-mode-sharing
    # convention the optional ceph sidecar below uses for its own owning container),
    # so it sees edge1's eth1 (fabric uplink to sw1) and eth3 (the now-dual-stack
    # v4+v6 WAN segment). `--role edge` attaches
    # wan_rx to eth3 (wan_rx re-encaps a WAN-client packet toward a backend after
    # Maglev-selecting it) and registers edge1's own loopback as the local-deliver
    # underlay (uplink_rx hands a DSR reply decapped to this underlay off to VyOS for
    # the last hop onto the WAN) — see flowplane/flowplane/src/control/mod.rs
    # Control::attach_edge. --uplink eth1 is the primary fabric ToR uplink (LOCAL's
    # outer-eth src + the encap next-hop target for --gateway-mac); eth2 (the second,
    # ECMP'd ToR) needs no --extra-uplink since uplink_rx decaps on the shared geneve
    # collect_md device, not the raw uplink NIC (attach_extra_uplink's doc comment).
    # --gateway is required by the CLI but unused by this role (no guest interfaces to
    # ARP-answer for); 169.254.0.1 is the same inert placeholder
    # charts/ectobase-pool/templates/dataplane-ebpf.yaml and the retired
    # hack/clab/edge-xdp-wrapper.sh both use. --gateway-mac is sw1's eth1-facing port
    # MAC, only learnable once the unnumbered BGP session is up (ND "router" flag) —
    # this placeholder is B11's to resolve live (dynamically, the way the production
    # DaemonSet + the retired edge wrapper both do: `ip -6 neigh show dev eth1 | grep
    # router`) before flowplane can actually forward. Only edge1 gets a sidecar — the
    # livetest (livetest/lb_test.go) targets edge1 only; edge2 is architecturally
    # identical and can get the same treatment once a live HA scenario needs it.
    flowplane-edge1:
      kind: linux
      image: {{ index .Images "flowplane" }}
      network-mode: container:clab-{{ .Name }}-edge1
      cap-add: ["NET_ADMIN", "SYS_ADMIN", "BPF"]
      binds:
        - /sys/fs/bpf:/sys/fs/bpf:shared
      env:
        # clab fabric links are veths (no native XDP/scatter-gather); test/edge-netns.sh's
        # reference `serve --role edge` invocation sets this too.
        FLOWPLANE_SKB_MODE: "1"
      cmd: >-
        serve --addr [::]:1337 --role edge --uplink eth1 --wan-uplink eth3
        --local-underlay {{ .EdgeLoopback }}::e1 --gateway 169.254.0.1
        --gateway-mac 02:00:00:00:00:01
    edge2:
      kind: linux
      image: {{ index .Images "vyos" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      binds:
        - vyos/edge2.set:/opt/vyatta/etc/config/scripts/vyos-postconfig-bootup.script
      sysctls: {net.ipv6.conf.all.forwarding: 1}

    nat64-1:
      kind: linux
      image: {{ index .Images "tayga" }}
      cap-add: ["NET_ADMIN"]
      devices: ["/dev/net/tun"]
      env:
        V6_ADDR: {{ .TaygaNet }}:1::2/64
        V6_GW: {{ .TaygaNet }}:1::1
        WAN_ADDR: 172.29.0.21/24
        WAN_GW: {{ .WanGwV4 }}
        POOL: 172.29.64.0/24
        POOL_ADDR: 172.29.64.1
    nat64-2:
      kind: linux
      image: {{ index .Images "tayga" }}
      cap-add: ["NET_ADMIN"]
      devices: ["/dev/net/tun"]
      env:
        V6_ADDR: {{ .TaygaNet }}:2::2/64
        V6_GW: {{ .TaygaNet }}:2::1
        WAN_ADDR: 172.29.0.22/24
        WAN_GW: {{ .WanGwV4 }}
        POOL: 172.29.65.0/24
        POOL_ADDR: 172.29.65.1

    sw1:
      kind: linux
      image: {{ index .Images "vyos" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      # vyos-router runs this as a vbash script on every boot (BGP+RA relay);
      # config.boot itself stays the image's stock default.
      binds:
        - vyos/sw1.set:/opt/vyatta/etc/config/scripts/vyos-postconfig-bootup.script
      sysctls: {net.ipv6.conf.all.forwarding: 1}
    sw2:
      kind: linux
      image: {{ index .Images "vyos" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      binds:
        - vyos/sw2.set:/opt/vyatta/etc/config/scripts/vyos-postconfig-bootup.script
      sysctls: {net.ipv6.conf.all.forwarding: 1}

    # --- Talos compute nodes: one container-mode Talos node per cluster node (P6
    # substrate). Each reads its machine config from USERDATA (base64, rendered by
    # talos.Gen into talos/<cluster>/<node>.env). containerlab runs every node
    # privileged, so Talos boots in container mode with a writable rootfs. Talos'
    # SetupSharedFilesystems marks /var, /etc/cni and /run MS_SHARED, which needs them
    # to be real mount points, so bind per-node dirs from build/<name>/mounts/<node>/
    # (a bind is a mount point regardless of backing store, keeping /var off RAM), and
    # bind the host kernel modules read-only for the kubelet. The nodes have NO clab-mgmt
    # interface (network-mode: none): their only interfaces are the two fabric uplinks +
    # dummy0, so the sole default route comes from the fabric (the ToRs' RA / BGP ::/0) —
    # fabric-only egress by construction, no mgmt default to leak past it. talosctl
    # bootstraps over the node's GoBGP-advertised /128, reached from the host via the
    # jump-veth (see talos.Bootstrap), not a mgmt net. ---
{{- range $n := .Nodes }}
    {{ $n.Name }}:
      kind: linux
      image: {{ index $.Images "talos" }}
      network-mode: none
      # System containerd (machined's own image pulls) resolves via the container
      # runtime's /etc/resolv.conf, which is read-only and — being fabric-only, no
      # mgmt — would otherwise inherit the host's non-DNS64 resolvers. Point it at the
      # two edge-loopback DNS64 resolvers so v4-only upstream registries (e.g.
      # ghcr.io/siderolabs/kubelet) synthesize a 64:ff9b::/96 AAAA and pull over
      # NAT64. (Talos's own machine-config nameservers can't rewrite this RO file in
      # container mode; hostDNS on 127.0.0.53 is likewise unreachable to docker's
      # resolv.conf generator, so set the fabric resolvers directly here.)
      dns:
        servers:
          - {{ $.EdgeLoopback }}::e1
          - {{ $.EdgeLoopback }}::e2
      env:
        PLATFORM: container
      env-files: [talos/{{ $n.Cluster }}/{{ $n.Name }}.env]
      binds:
        - mounts/{{ $n.Name }}/run:/run
        - mounts/{{ $n.Name }}/var:/var
        - mounts/{{ $n.Name }}/cni:/etc/cni
        - {{ $.ModulesDir }}:/usr/lib/modules:ro
      sysctls:
        net.ipv6.conf.all.disable_ipv6: "0"
{{- end }}
    wan:
      kind: linux
      image: {{ index .Images "wan" }}
      # All lab images are built locally (make lab-images) and not pushed to a
      # remote registry, so keep clab's IfNotPresent default — an Always policy
      # would force a failing remote pull of the local-only wan image.
      cap-add: ["NET_ADMIN"]
      env:
        WAN_V4_ADDR: {{ .Wan.V4Addr }}
        WAN_V6_ADDR: {{ .Wan.V6Addr }}
        WAN_MASQ_V4: "{{ join " " .Wan.MasqV4 }}"
        WAN_MASQ_V6: "{{ join " " .Wan.MasqV6 }}"
        WAN_ROUTES: "{{ range $i, $r := .Wan.Routes }}{{ if $i }};{{ end }}{{ $r.Prefix }} {{ join "," $r.NextHops }}{{ end }}"
        # eth5 is the registry link; it must join br0 (the WAN L2 segment) so the
        # registry (fd00:29::5 on eth5) is reachable over the fabric from the nodes.
        # eth6 is the host↔WAN jump link; it must also join br0 so the host's
        # fd00:29::100 (addHostFabricRoute) is on the same WAN segment as the edges.
        WAN_LAN_IFACES: "eth1 eth2 eth3 eth4 eth5 eth6"

    registry:
      kind: linux
      image: {{ index .Images "registry" }}
      # Persistent pull-through + push-local mirror. registry:2 reads its config
      # from /etc/docker/registry/config.yml; the cache is a host-path dir (clab
      # binds cannot name docker volumes). The exec entries give the registry its
      # fabric address on the WAN segment after clab attaches the veths.
      # Host pushes to 127.0.0.1:5000 (docker-default-insecure); nodes pull via the
      # fabric addr — same registry:2 process, same filesystem storage backend.
      ports:
        - "127.0.0.1:5000:5000"
      binds:
        - registry/config.yml:/etc/docker/registry/config.yml
        - registry-cache:/var/lib/registry
      exec:
        - ip -6 addr add {{ .RegistryAddr }}/64 dev eth1
        - ip -6 route replace default via {{ .WanNet }}::1
{{- if .CephEnabled }}

    # --- optional shared Ceph/demo storage node (Tier-2 storage fencing) ---
    # Each compute node reaches the mon via its own /64 underlay = the Tier-2 fence
    # coordinate, so ceph lives on its OWN fabric /64 ({{ .CephNet64 }}, mon {{ .CephMonAddr }}).
    #
    # NETNS OWNER = ceph-net (FRR), NOT ceph. ceph/demo has no `ip` and, given an
    # IPv6-only CEPH_PUBLIC_NETWORK, exits at boot if the /64 isn't already on an
    # interface — but a co-netns sidecar can only start AFTER its target is running
    # (chicken-and-egg). So the FRR container owns the netns + the sw1/sw2 uplinks,
    # creates dummy0 ({{ .CephMonAddr }}/64) FIRST, then ceph/demo joins that netns
    # (startup-delay) and finds the /64 already present.
    ceph-net:
      kind: linux
      image: {{ index .Images "frr" }}
      binds:
        - ceph/frr-daemons:/etc/frr/daemons
        - ceph/frr.conf:/etc/frr/frr.conf
        - ceph/ceph-preboot.sh:/ceph-preboot.sh:ro
      entrypoint: "/bin/sh /ceph-preboot.sh"
      sysctls:
        net.ipv6.conf.all.forwarding: 1
    # ceph/demo (mon+mgr+osd) shares ceph-net's netns; by the time it boots, dummy0
    # already carries {{ .CephMonAddr }}/64 so MON_IP binds cleanly. Ephemeral (no
    # persistent binds: clab reads a bare `name:/path` bind as a relative host path
    # and fails verification).
    ceph:
      kind: linux
      image: {{ index .Images "ceph" }}
      network-mode: container:clab-{{ .Name }}-ceph-net
      startup-delay: 20   # wait for ceph-net to create dummy0 + the /64 before ceph/demo binds MON_IP
      # ceph/demo IPv6 knobs (the demo image mishandles v6 out of the box):
      #   MON_IP bracketed -> the demo writes `mon host = v2:${MON_IP}:${MON_PORT}` verbatim;
      #     without brackets a v6 addr swallows the port so clients hunt a bogus addr and the
      #     bootstrap RADOS-times-out. Bracketing also keeps monmaptool/--public-addr correct.
      #   IP_VERSION=6 -> makes the demo add `ms bind ipv6 = true` to ceph.conf.
      #   CEPH_ARGS ms-bind-ipv4=false -> the OSD/MGR otherwise try to pick a v4 public_addr
      #     from the v6-only public_network and abort. osd-pool-default-size=1 suits the
      #     single-OSD demo (no degraded/undersized PGs -> RBD provisions clean).
      #   DEMO_DAEMONS=osd -> bring up only mon+mgr+osd (all RBD needs); skip rgw + mds/nfs.
      env:
        MON_IP: "[{{ .CephMonAddr }}]"
        CEPH_PUBLIC_NETWORK: {{ .CephNet64 }}
        IP_VERSION: "6"
        CEPH_ARGS: "--ms-bind-ipv4=false --osd-pool-default-size=1"
        DEMO_DAEMONS: osd
{{- end }}

  links:
    - endpoints: ["edge1:eth1", "sw1:eth1"]
      mtu: 1500
    - endpoints: ["edge1:eth2", "sw2:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth1", "sw1:eth2"]
      mtu: 1500
    - endpoints: ["edge2:eth2", "sw2:eth2"]
      mtu: 1500
{{- range $n := .Nodes }}
    # Jumbo (9000) on the compute-node underlay uplinks so the E/W overlay can carry jumbo guest
    # frames (guest MTU = 9000 - 40 encap = 8960). Compute nodes run generic/SKB XDP on clab (native
    # veth redirect is unsupported), which carries non-linear frames fine; the native #[xdp(frags)]
    # fast path is HW-gated. N/S edge links stay 1500 (guests PMTU-clamp for internet egress).
    - endpoints: ["{{ $n.Name }}:eth1", "sw1:eth{{ add 2 $n.PortSeq }}"]
      mtu: 9000
    - endpoints: ["{{ $n.Name }}:eth2", "sw2:eth{{ add 2 $n.PortSeq }}"]
      mtu: 9000
{{- end }}
    - endpoints: ["edge1:eth3", "wan:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth3", "wan:eth2"]
      mtu: 1500
    - endpoints: ["edge1:eth4", "nat64-1:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth4", "nat64-2:eth1"]
      mtu: 1500
    - endpoints: ["nat64-1:eth2", "wan:eth3"]
      mtu: 1500
    - endpoints: ["nat64-2:eth2", "wan:eth4"]
      mtu: 1500
    - endpoints: ["registry:eth1", "wan:eth5"]
      mtu: 1500
    # Host↔WAN jump: one veth from the host root netns onto the WAN segment (br0 in
    # the wan container). The host assigns fd00:29::100 here (addHostFabricRoute) and
    # routes fd00:cafe::/32 via fd00:29::1 — the single controlled ingress that
    # replaces the disabled mgmt network.
    - endpoints: ["wan:eth6", "host:ectojump"]
      mtu: 1500
{{- if .CephEnabled }}
    # --- shared Ceph storage node: dual-homed to both ToRs (eth1->sw1, eth2->sw2),
    # the next free host port on each ToR (CephPortSeq = totalNodes + 1). The ceph-net
    # FRR sidecar (in the ceph netns) peers over both and announces the ceph /64 so
    # every compute node reaches the mon from its own /64. ---
    - endpoints: ["ceph-net:eth1", "sw1:eth{{ add 2 .CephPortSeq }}"]
      mtu: 1500
    - endpoints: ["ceph-net:eth2", "sw2:eth{{ add 2 .CephPortSeq }}"]
      mtu: 1500
{{- end }}
