# Generated from templates/fabric.clab.yml.tmpl — do not edit by hand.
name: {{ .Name }}

mgmt:
  network: {{ .Name }}-mgmt
  # P3b: the fabric routers (edge/switch) are detached from mgmt via a per-node
  # network-mode override below (no eth0, no mgmt default — fabric-only). The mgmt
  # net still exists for the registry's published host port + other infra; compute
  # nodes use kind's own bridge (eth0 default demoted by fabric-preboot so the
  # fabric BGP default is preferred). The host reaches the fabric via the
  # WAN-segment jump veth (below), not a mgmt route.

topology:
  defaults:
    env:
      TZ: UTC

  nodes:
    edge1:
      kind: linux
      image: {{ index .Images "frr" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      binds:
        - frr/edge1.conf:/etc/frr/frr.conf
        - frr/daemons:/etc/frr/daemons
      sysctls: {net.ipv6.conf.all.forwarding: 1}
    edge2:
      kind: linux
      image: {{ index .Images "frr" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      binds:
        - frr/edge2.conf:/etc/frr/frr.conf
        - frr/daemons:/etc/frr/daemons
      sysctls: {net.ipv6.conf.all.forwarding: 1}

    # flowplane WAN-edge sidecar: shares the edge1 FRR netns and runs wan_rx so the
    # fabric has a real N/S LoadBalancer edge (FRR alone cannot run the eBPF datapath).
    # SKB mode (kind veths are MTU 1500); the wrapper attaches uplink_rx on eth1/eth2 and
    # wan_rx on eth3 in edge1's netns. Uses the host-local flowplane :dev image (IfNotPresent).
    flowplane-edge1:
      kind: linux
      image: {{ index .Images "flowplane" }}
      network-mode: container:clab-{{ .Name }}-edge1
      cap-add: ["NET_ADMIN", "SYS_ADMIN", "BPF", "PERFMON", "NET_RAW"]
      binds:
        - flowplane/edge-wrapper.sh:/edge-wrapper.sh:ro
        - /sys/fs/bpf:/sys/fs/bpf
      startup-delay: 35   # wait for edge1 (FRR) + clab veths before attaching XDP in its netns
      entrypoint: "/bin/sh /edge-wrapper.sh"

    nat64-1:
      kind: linux
      image: {{ index .Images "tayga" }}
      cap-add: ["NET_ADMIN"]
      devices: ["/dev/net/tun"]
      env:
        V6_ADDR: {{ .TaygaNet }}:1::2/64
        V6_GW: {{ .TaygaNet }}:1::1
        WAN_ADDR: 172.29.0.21/24
        WAN_GW: {{ .WanGwV4 }}
        POOL: 172.29.64.0/24
        POOL_ADDR: 172.29.64.1
    nat64-2:
      kind: linux
      image: {{ index .Images "tayga" }}
      cap-add: ["NET_ADMIN"]
      devices: ["/dev/net/tun"]
      env:
        V6_ADDR: {{ .TaygaNet }}:2::2/64
        V6_GW: {{ .TaygaNet }}:2::1
        WAN_ADDR: 172.29.0.22/24
        WAN_GW: {{ .WanGwV4 }}
        POOL: 172.29.65.0/24
        POOL_ADDR: 172.29.65.1

    sw1:
      kind: linux
      image: {{ index .Images "frr" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      binds:
        - frr/sw1.conf:/etc/frr/frr.conf
        - frr/daemons:/etc/frr/daemons
      sysctls: {net.ipv6.conf.all.forwarding: 1}
    sw2:
      kind: linux
      image: {{ index .Images "frr" }}
      network-mode: none   # P3b: detach from clab mgmt — no eth0, fabric-only (links still attach)
      binds:
        - frr/sw2.conf:/etc/frr/frr.conf
        - frr/daemons:/etc/frr/daemons
      sysctls: {net.ipv6.conf.all.forwarding: 1}

    # flowplane xdp_pass sidecar: shares the sw1 FRR netns and attaches the trivial xdp_pass program
    # to sw1's edge-facing veths (eth1 = edge1's LOCAL uplink, eth2 = edge2's LOCAL uplink). The WAN
    # edge runs NATIVE XDP and XDP_REDIRECTs the encapped N/S-LB frame out its LOCAL uplink onto sw1;
    # the kernel drops a veth-redirected frame unless the receiving peer has an XDP program — a
    # kind/clab veth artifact (redirect to a real NIC works). Uses the flowplane image's built-in
    # xdp_pass (`flowplane pass`), so nothing is vendored. sw2 is never a redirect target (it carries
    # the edges' extra-uplink, an uplink_rx RECEIVE side).
    flowplane-pass-sw1:
      kind: linux
      image: {{ index .Images "flowplane" }}
      network-mode: container:clab-{{ .Name }}-sw1
      cap-add: ["NET_ADMIN", "SYS_ADMIN", "BPF", "PERFMON", "NET_RAW"]
      binds:
        - /sys/fs/bpf:/sys/fs/bpf
      startup-delay: 35   # wait for sw1 (FRR) + clab veths before attaching XDP in its netns
      entrypoint: "flowplane pass --iface eth1 --iface eth2"

    # --- kind clusters: one k8s-kind lifecycle node per cluster (clab runs `kind
    # create`; the kind cluster is named after this node). The per-node kind
    # containers (<cluster>-control-plane / -worker) are declared as ext-container
    # nodes below and carry the fabric links — attaching links to the k8s-kind
    # lifecycle node itself fails ("network namespace not available") since it owns
    # no netns of its own. ---
{{- range $c := .ClusterNames }}
    {{ $c }}:
      kind: k8s-kind
      startup-config: kind/{{ $c }}-kind.yaml
      extras:
        k8s_kind:
          deploy:
            wait: 120s   # clab k8s-kind boot-marker scan timeout (NOT a node-Ready gate); must exceed the node preboot delay
{{- end }}
    # The kind-created node containers, as clab link endpoints. ext-container =
    # attach to the already-existing container kind made; names MUST match kind's
    # (<cluster>-control-plane / <cluster>-worker[N] — see DerivedNode.KindContainer).
{{- range $n := .Nodes }}
    {{ $n.KindContainer }}:
      kind: ext-container
{{- end }}
    wan:
      kind: linux
      image: {{ index .Images "wan" }}
      # All lab images are built locally (make lab-images) and not pushed to a
      # remote registry, so keep clab's IfNotPresent default — an Always policy
      # would force a failing remote pull of the local-only wan image.
      cap-add: ["NET_ADMIN"]
      env:
        WAN_V4_ADDR: {{ .Wan.V4Addr }}
        WAN_V6_ADDR: {{ .Wan.V6Addr }}
        WAN_MASQ_V4: "{{ join " " .Wan.MasqV4 }}"
        WAN_MASQ_V6: "{{ join " " .Wan.MasqV6 }}"
        WAN_ROUTES: "{{ range $i, $r := .Wan.Routes }}{{ if $i }};{{ end }}{{ $r.Prefix }} {{ join "," $r.NextHops }}{{ end }}"
        # eth5 is the registry link; it must join br0 (the WAN L2 segment) so the
        # registry (fd00:29::5 on eth5) is reachable over the fabric from the nodes.
        # eth6 is the host↔WAN jump link; it must also join br0 so the host's
        # fd00:29::100 (addHostFabricRoute) is on the same WAN segment as the edges.
        WAN_LAN_IFACES: "eth1 eth2 eth3 eth4 eth5 eth6"

    registry:
      kind: linux
      image: {{ index .Images "registry" }}
      # Persistent pull-through + push-local mirror. registry:2 reads its config
      # from /etc/docker/registry/config.yml; the cache is a host-path dir (clab
      # binds cannot name docker volumes). The exec entries give the registry its
      # fabric address on the WAN segment after clab attaches the veths.
      # Host pushes to 127.0.0.1:5000 (docker-default-insecure); nodes pull via the
      # fabric addr — same registry:2 process, same filesystem storage backend.
      ports:
        - "127.0.0.1:5000:5000"
      binds:
        - registry/config.yml:/etc/docker/registry/config.yml
        - registry-cache:/var/lib/registry
      exec:
        - ip -6 addr add {{ .RegistryAddr }}/64 dev eth1
        - ip -6 route replace default via {{ .WanNet }}::1
{{- if .CephEnabled }}

    # --- optional shared Ceph/demo storage node (Tier-2 storage fencing) ---
    # Each compute node reaches the mon via its own /64 underlay = the Tier-2 fence
    # coordinate, so ceph lives on its OWN fabric /64 ({{ .CephNet64 }}, mon {{ .CephMonAddr }}).
    #
    # NETNS OWNER = ceph-net (FRR), NOT ceph. ceph/demo has no `ip` and, given an
    # IPv6-only CEPH_PUBLIC_NETWORK, exits at boot if the /64 isn't already on an
    # interface — but a co-netns sidecar can only start AFTER its target is running
    # (chicken-and-egg). So the FRR container owns the netns + the sw1/sw2 uplinks,
    # creates dummy0 ({{ .CephMonAddr }}/64) FIRST, then ceph/demo joins that netns
    # (startup-delay) and finds the /64 already present.
    ceph-net:
      kind: linux
      image: {{ index .Images "frr" }}
      binds:
        - ceph/frr-daemons:/etc/frr/daemons
        - ceph/frr.conf:/etc/frr/frr.conf
        - ceph/ceph-preboot.sh:/ceph-preboot.sh:ro
      entrypoint: "/bin/sh /ceph-preboot.sh"
      sysctls:
        net.ipv6.conf.all.forwarding: 1
    # ceph/demo (mon+mgr+osd) shares ceph-net's netns; by the time it boots, dummy0
    # already carries {{ .CephMonAddr }}/64 so MON_IP binds cleanly. Ephemeral (no
    # persistent binds: clab reads a bare `name:/path` bind as a relative host path
    # and fails verification).
    ceph:
      kind: linux
      image: {{ index .Images "ceph" }}
      network-mode: container:clab-{{ .Name }}-ceph-net
      startup-delay: 20   # wait for ceph-net to create dummy0 + the /64 before ceph/demo binds MON_IP
      # ceph/demo IPv6 knobs (the demo image mishandles v6 out of the box):
      #   MON_IP bracketed -> the demo writes `mon host = v2:${MON_IP}:${MON_PORT}` verbatim;
      #     without brackets a v6 addr swallows the port so clients hunt a bogus addr and the
      #     bootstrap RADOS-times-out. Bracketing also keeps monmaptool/--public-addr correct.
      #   IP_VERSION=6 -> makes the demo add `ms bind ipv6 = true` to ceph.conf.
      #   CEPH_ARGS ms-bind-ipv4=false -> the OSD/MGR otherwise try to pick a v4 public_addr
      #     from the v6-only public_network and abort. osd-pool-default-size=1 suits the
      #     single-OSD demo (no degraded/undersized PGs -> RBD provisions clean).
      #   DEMO_DAEMONS=osd -> bring up only mon+mgr+osd (all RBD needs); skip rgw + mds/nfs.
      env:
        MON_IP: "[{{ .CephMonAddr }}]"
        CEPH_PUBLIC_NETWORK: {{ .CephNet64 }}
        IP_VERSION: "6"
        CEPH_ARGS: "--ms-bind-ipv4=false --osd-pool-default-size=1"
        DEMO_DAEMONS: osd
{{- end }}

  links:
    - endpoints: ["edge1:eth1", "sw1:eth1"]
      mtu: 1500
    - endpoints: ["edge1:eth2", "sw2:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth1", "sw1:eth2"]
      mtu: 1500
    - endpoints: ["edge2:eth2", "sw2:eth2"]
      mtu: 1500
{{- range $n := .Nodes }}
    # Jumbo (9000) on the compute-node underlay uplinks so the E/W overlay can carry jumbo guest
    # frames (guest MTU = 9000 - 40 encap = 8960). Compute nodes run generic/SKB XDP on clab (native
    # veth redirect is unsupported), which carries non-linear frames fine; the native #[xdp(frags)]
    # fast path is HW-gated. N/S edge links stay 1500 (guests PMTU-clamp for internet egress).
    - endpoints: ["{{ $n.KindContainer }}:eth1", "sw1:eth{{ add 2 $n.PortSeq }}"]
      mtu: 9000
    - endpoints: ["{{ $n.KindContainer }}:eth2", "sw2:eth{{ add 2 $n.PortSeq }}"]
      mtu: 9000
{{- end }}
    - endpoints: ["edge1:eth3", "wan:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth3", "wan:eth2"]
      mtu: 1500
    - endpoints: ["edge1:eth4", "nat64-1:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth4", "nat64-2:eth1"]
      mtu: 1500
    - endpoints: ["nat64-1:eth2", "wan:eth3"]
      mtu: 1500
    - endpoints: ["nat64-2:eth2", "wan:eth4"]
      mtu: 1500
    - endpoints: ["registry:eth1", "wan:eth5"]
      mtu: 1500
    # Host↔WAN jump: one veth from the host root netns onto the WAN segment (br0 in
    # the wan container). The host assigns fd00:29::100 here (addHostFabricRoute) and
    # routes fd00:cafe::/32 via fd00:29::1 — the single controlled ingress that
    # replaces the disabled mgmt network.
    - endpoints: ["wan:eth6", "host:ectojump"]
      mtu: 1500
{{- if .CephEnabled }}
    # --- shared Ceph storage node: dual-homed to both ToRs (eth1->sw1, eth2->sw2),
    # the next free host port on each ToR (CephPortSeq = totalNodes + 1). The ceph-net
    # FRR sidecar (in the ceph netns) peers over both and announces the ceph /64 so
    # every compute node reaches the mon from its own /64. ---
    - endpoints: ["ceph-net:eth1", "sw1:eth{{ add 2 .CephPortSeq }}"]
      mtu: 1500
    - endpoints: ["ceph-net:eth2", "sw2:eth{{ add 2 .CephPortSeq }}"]
      mtu: 1500
{{- end }}
