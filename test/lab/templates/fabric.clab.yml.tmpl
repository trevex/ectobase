# Generated from templates/fabric.clab.yml.tmpl — do not edit by hand.
name: {{ .Name }}

mgmt:
  network: {{ .Name }}-mgmt
  ipv4-subnet: 172.20.20.0/24
  ipv6-subnet: {{ .MgmtV6Subnet }}

topology:
  defaults:
    env:
      TZ: UTC

  nodes:
    edge1:
      kind: vyosnetworks_vyos
      image: {{ index .Images "vyos" }}
      startup-config: vyos/edge1.boot
      enforce-startup-config: true
      sysctls: {net.ipv6.conf.all.forwarding: 1}
      # Drop the docker-injected mgmt default (a kernel route, FRR distance 0) so
      # FRR selects the BGP/static ::/0 and egress leaves via the fabric, not mgmt.
      exec:
        - "ip -6 route del default via {{ .MgmtV6Gateway }} dev eth0"
    edge2:
      kind: vyosnetworks_vyos
      image: {{ index .Images "vyos" }}
      startup-config: vyos/edge2.boot
      enforce-startup-config: true
      sysctls: {net.ipv6.conf.all.forwarding: 1}
      # Drop the docker-injected mgmt default (a kernel route, FRR distance 0) so
      # FRR selects the BGP/static ::/0 and egress leaves via the fabric, not mgmt.
      exec:
        - "ip -6 route del default via {{ .MgmtV6Gateway }} dev eth0"

    nat64-1:
      kind: linux
      image: {{ index .Images "tayga" }}
      cap-add: ["NET_ADMIN"]
      devices: ["/dev/net/tun"]
      env:
        V6_ADDR: {{ .TaygaNet }}:1::2/64
        V6_GW: {{ .TaygaNet }}:1::1
        WAN_ADDR: 172.29.0.21/24
        WAN_GW: {{ .WanGwV4 }}
        POOL: 172.29.64.0/24
        POOL_ADDR: 172.29.64.1
    nat64-2:
      kind: linux
      image: {{ index .Images "tayga" }}
      cap-add: ["NET_ADMIN"]
      devices: ["/dev/net/tun"]
      env:
        V6_ADDR: {{ .TaygaNet }}:2::2/64
        V6_GW: {{ .TaygaNet }}:2::1
        WAN_ADDR: 172.29.0.22/24
        WAN_GW: {{ .WanGwV4 }}
        POOL: 172.29.65.0/24
        POOL_ADDR: 172.29.65.1

    sw1:
      kind: vyosnetworks_vyos
      image: {{ index .Images "vyos" }}
      startup-config: vyos/sw1.boot
      enforce-startup-config: true
      sysctls: {net.ipv6.conf.all.forwarding: 1}
      # Drop the docker-injected mgmt default (a kernel route, FRR distance 0) so
      # FRR selects the BGP/static ::/0 and egress leaves via the fabric, not mgmt.
      exec:
        - "ip -6 route del default via {{ .MgmtV6Gateway }} dev eth0"
    sw2:
      kind: vyosnetworks_vyos
      image: {{ index .Images "vyos" }}
      startup-config: vyos/sw2.boot
      enforce-startup-config: true
      sysctls: {net.ipv6.conf.all.forwarding: 1}
      # Drop the docker-injected mgmt default (a kernel route, FRR distance 0) so
      # FRR selects the BGP/static ::/0 and egress leaves via the fabric, not mgmt.
      exec:
        - "ip -6 route del default via {{ .MgmtV6Gateway }} dev eth0"

{{- range $n := .Nodes }}
    {{ $n.Cluster }}-{{ $n.Index }}:
      kind: linux
      image: {{ index $.Images "talos" }}
      # containerlab runs every node privileged, so Talos boots in container mode
      # with a writable rootfs; it reads its machine config from USERDATA. Talos'
      # SetupSharedFilesystems marks /var, /etc/cni and /run MS_SHARED, which needs
      # them to be real mount points (containerlab has no tmpfs key), so we bind
      # per-node dirs. They live on disk under build/<name>/mounts — a bind is a
      # mount point regardless of backing store, so this keeps /var off RAM.
      env:
        PLATFORM: container
      env-files: [talos/{{ $n.Cluster }}-{{ $n.Index }}.env]
      binds:
        - mounts/{{ $n.Cluster }}-{{ $n.Index }}/run:/run
        - mounts/{{ $n.Cluster }}-{{ $n.Index }}/var:/var
        - mounts/{{ $n.Cluster }}-{{ $n.Index }}/cni:/etc/cni
        - {{ $.ModulesDir }}:/usr/lib/modules:ro
      sysctls:
        net.ipv6.conf.all.disable_ipv6: "0"
{{- end }}
    wan:
      kind: linux
      image: {{ index .Images "wan" }}
      # All lab images are built locally (make lab-images) and not pushed to a
      # remote registry, so keep clab's IfNotPresent default — an Always policy
      # would force a failing remote pull of the local-only wan image.
      cap-add: ["NET_ADMIN"]
      env:
        WAN_V4_ADDR: {{ .Wan.V4Addr }}
        WAN_V6_ADDR: {{ .Wan.V6Addr }}
        WAN_MASQ_V4: "{{ join " " .Wan.MasqV4 }}"
        WAN_MASQ_V6: "{{ join " " .Wan.MasqV6 }}"
        WAN_ROUTES: "{{ range $i, $r := .Wan.Routes }}{{ if $i }};{{ end }}{{ $r.Prefix }} {{ join "," $r.NextHops }}{{ end }}"
        # eth5 is the registry link; it must join br0 (the WAN L2 segment) so the
        # registry (fd00:29::5 on eth5) is reachable over the fabric from the nodes.
        WAN_LAN_IFACES: "eth1 eth2 eth3 eth4 eth5"

    registry:
      kind: linux
      image: {{ index .Images "registry" }}
      # Persistent pull-through + push-local mirror. registry:2 reads its config
      # from /etc/docker/registry/config.yml; the cache is a host-path dir (clab
      # binds cannot name docker volumes). The exec entries give the registry its
      # fabric address on the WAN segment after clab attaches the veths.
      # Host pushes to 127.0.0.1:5000 (docker-default-insecure); nodes pull via the
      # fabric addr — same registry:2 process, same filesystem storage backend.
      ports:
        - "127.0.0.1:5000:5000"
      binds:
        - registry/config.yml:/etc/docker/registry/config.yml
        - registry-cache:/var/lib/registry
      exec:
        - ip -6 addr add {{ .RegistryAddr }}/64 dev eth1
        - ip -6 route replace default via {{ .WanNet }}::1

  links:
    - endpoints: ["edge1:eth1", "sw1:eth1"]
      mtu: 1500
    - endpoints: ["edge1:eth2", "sw2:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth1", "sw1:eth2"]
      mtu: 1500
    - endpoints: ["edge2:eth2", "sw2:eth2"]
      mtu: 1500
{{- range $n := .Nodes }}
    - endpoints: ["{{ $n.Cluster }}-{{ $n.Index }}:eth1", "sw1:eth{{ add 2 $n.PortSeq }}"]
      mtu: 1500
    - endpoints: ["{{ $n.Cluster }}-{{ $n.Index }}:eth2", "sw2:eth{{ add 2 $n.PortSeq }}"]
      mtu: 1500
{{- end }}
    - endpoints: ["edge1:eth3", "wan:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth3", "wan:eth2"]
      mtu: 1500
    - endpoints: ["edge1:eth4", "nat64-1:eth1"]
      mtu: 1500
    - endpoints: ["edge2:eth4", "nat64-2:eth1"]
      mtu: 1500
    - endpoints: ["nat64-1:eth2", "wan:eth3"]
      mtu: 1500
    - endpoints: ["nat64-2:eth2", "wan:eth4"]
      mtu: 1500
    - endpoints: ["registry:eth1", "wan:eth5"]
      mtu: 1500
