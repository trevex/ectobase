set system host-name 'sw{{ .SW }}'
set service ssh
set system login user admin authentication plaintext-password 'admin'
set protocols bgp system-as '{{ .ASSwitch }}'
set protocols bgp parameters router-id '10.0.1.{{ .SW }}'
set protocols bgp parameters bestpath as-path multipath-relax
set protocols bgp address-family ipv6-unicast maximum-paths ebgp '64'
set protocols bgp peer-group edges remote-as 'external'
set protocols bgp peer-group edges capability extended-nexthop
set protocols bgp peer-group edges bfd
set protocols bgp peer-group edges address-family ipv6-unicast
set protocols bgp neighbor eth1 interface v6only peer-group 'edges'
set protocols bgp neighbor eth2 interface v6only peer-group 'edges'
set protocols bgp peer-group hosts remote-as 'external'
set protocols bgp peer-group hosts capability extended-nexthop
set protocols bgp peer-group hosts address-family ipv6-unicast as-override
{{- range $n := .Nodes }}
{{- $eth := printf "eth%d" (add 2 $n.PortSeq) }}
{{- /* Per-switch RA /64 (fd00:db8:<SW>:<portSeq>::/64): each switch advertises a
       DISTINCT prefix so the node's two uplinks hold addresses in different /64s.
       A shared /64 across both uplinks breaks the return path — a reply routed via
       the "wrong" switch can't ND-resolve an address that lives on the other
       uplink, black-holing native-v6 egress. */}}
{{- $ra := printf "%s:%d:%d::/64" $.RAPrefix $.SW $n.PortSeq }}
set protocols bgp neighbor {{ $eth }} interface v6only peer-group 'hosts'
set protocols static route6 {{ $ra }} interface {{ $eth }}
set protocols bgp address-family ipv6-unicast network '{{ $ra }}'
{{- /* Originate the node's underlay /64 (guest-endpoint underlays are allocated in its upper half).
       Talos native GoBGP can only advertise host routes (/128), so the node cannot announce its /64
       itself; the directly-connected ToR originates it here. RECURSIVE next-hop = the node identity
       /128 (learned from this node via BGP on {{ $eth }}) — a via-interface static would try to ND-
       resolve endpoint underlays that live only inside flowplane, not on the node's uplink. The
       recursive route self-withdraws (nexthop tracking) when the node's /128 is withdrawn. */}}
set protocols static route6 {{ $n.NodeNet64 }} next-hop {{ $n.IdentityAddr }}
set protocols bgp address-family ipv6-unicast network '{{ $n.NodeNet64 }}'
set service router-advert interface {{ $eth }} prefix {{ $ra }}
set service router-advert interface {{ $eth }} name-server '{{ $.EdgeLoopback }}::e1'
set service router-advert interface {{ $eth }} name-server '{{ $.EdgeLoopback }}::e2'
{{- end }}
{{- if .CephEnabled }}
{{- /* Optional Ceph host-port: the ceph node dual-homes to both ToRs at the next
       free host port (CephPortSeq = totalNodes + 1). It peers into the same 'hosts'
       peer-group (as-override) so the ceph /64 it announces propagates to every node.
       The ceph sidecar announces its /64 itself over unnumbered eBGP, so — unlike the
       Talos nodes — the switch does NOT originate a recursive /64 for it. */}}
{{- $ceth := printf "eth%d" (add 2 $.CephPortSeq) }}
{{- $cra := printf "%s:%d:%d::/64" $.RAPrefix $.SW $.CephPortSeq }}
set protocols bgp neighbor {{ $ceth }} interface v6only peer-group 'hosts'
set protocols static route6 {{ $cra }} interface {{ $ceth }}
set protocols bgp address-family ipv6-unicast network '{{ $cra }}'
set service router-advert interface {{ $ceth }} prefix {{ $cra }}
set service router-advert interface {{ $ceth }} name-server '{{ $.EdgeLoopback }}::e1'
set service router-advert interface {{ $ceth }} name-server '{{ $.EdgeLoopback }}::e2'
{{- end }}
