kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  ipFamily: ipv6
  disableDefaultCNI: true
  kubeProxyMode: none
# Pull :dev + upstream images through the in-fabric registry mirror (fabric-parity
# with the removed Talos machine.registries.mirrors). containerd 2.x: the mirror is
# configured via config_path/hosts.toml (mounted at /etc/containerd/certs.d), NOT the
# legacy inline registry.mirrors — inline mirrors corrupt the CRI plugin on containerd
# v2 (kubelet: "unknown service runtime.v1.RuntimeService").
containerdConfigPatches:
  - |-
    [plugins."io.containerd.grpc.v1.cri".registry]
      config_path = "/etc/containerd/certs.d"
nodes:
{{- range .Nodes }}
  - role: {{ .Role }}
    image: {{ .Image }}
    extraMounts:
      - hostPath: {{ .PrefixPath }}
        containerPath: /etc/fabric/prefix
        readOnly: true
      - hostPath: {{ .UplinksPath }}
        containerPath: /etc/fabric/uplinks
        readOnly: true
      - hostPath: {{ .CertsDir }}
        containerPath: /etc/containerd/certs.d
        readOnly: true
{{- end }}
