# Cilium values for the container-mode Talos IPv6 fabric.
# IPv6-only, tunnel (vxlan) routing, kube-proxy replacement via Talos KubePrism.
ipv4:
  enabled: false
ipv6:
  enabled: true

kubeProxyReplacement: true
# Talos KubePrism — a host-local apiserver load-balancer, decoupled from the
# anycast API VIP + BGP convergence (Talos-recommended for kube-proxy replacement).
k8sServiceHost: localhost
k8sServicePort: 7445

# Single operator replica: clusters default to one control-plane node, and the
# operator's default 2 replicas have anti-affinity that leaves the 2nd Pending on
# a 1-node cluster → `helm --wait` never sees 2/2. One operator is fine for a lab.
operator:
  replicas: 1

routingMode: tunnel
tunnelProtocol: vxlan

ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv6PodCIDRList:
      - {{ .PodSubnet }}
    # Per-node pod CIDR mask. Cilium's cluster-pool allocator caps the node-CIDR
    # count at 2^16, so (maskSize - poolMask) must be <= 16; the pod pool is a /56,
    # so /64 is the largest (and natural IPv6) per-node size.
    clusterPoolIPv6MaskSize: 64

bpf:
  # iptables (not BPF) masquerade: route-source masquerade below is only supported on
  # the iptables path (the agent rejects enable-masquerade-to-route-source with
  # enable-bpf-masquerade=true). Perf is irrelevant for the lab.
  masquerade: false
enableIPv6Masquerade: true
# Masquerade pod egress to the ROUTE SOURCE — the node's announced identity
# fd00:cafe:<h>::1 (dummy0 = the k8s InternalIP + BGP-advertised address) — not the
# egress device's ephemeral RA-SLAAC uplink address. Without this, pod traffic to a
# fabric /64 (e.g. the ceph mon on fd00:cafe:635::/64) is SNATed to a SLAAC uplink addr
# whose return path breaks, so librbd hangs. The node identity is stable + fabric-routable.
enableMasqueradeRouteSource: true

# Talos runs Cilium in a container-mode node: mount the host cgroup rather than
# letting the agent auto-mount, and grant the capability sets Talos documents.
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
