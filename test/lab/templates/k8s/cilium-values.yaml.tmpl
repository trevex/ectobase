# Generated from templates/k8s/cilium-values.yaml.tmpl — do not edit by hand.
# Cilium values for the container-mode Talos IPv6 fabric.
# IPv6-only, tunnel (vxlan) routing, kube-proxy replacement via Talos KubePrism.
ipv4:
  enabled: false
ipv6:
  enabled: true

kubeProxyReplacement: true
# Talos KubePrism — a host-local apiserver load-balancer, decoupled from the anycast
# API address + GoBGP convergence (Talos-recommended for kube-proxy replacement). The
# cluster-patch's KubePrismConfig pins this same port (7445).
k8sServiceHost: localhost
k8sServicePort: "7445"

routingMode: tunnel
tunnelProtocol: vxlan

# Coexist with Multus. Cilium defaults to cni.exclusive=true, which makes the agent
# take sole ownership of /etc/cni/net.d and RENAME every other CNI conf to
# `*.cilium_bak` — including Multus's `00-multus.conflist`. That silently disables the
# Multus secondary-network attach the flowplane overlay rides on: the pod then comes up
# with only Cilium's primary eth0 and never gets its overlay net1. Turn exclusivity off
# so Multus's top-level conf survives and delegates the default network to Cilium.
cni:
  exclusive: false

# Single-replica operator: every lab cluster is a single control-plane node, and the
# operator Deployment defaults to 2 replicas with a hard (required) pod anti-affinity
# on hostname — the second replica is unschedulable on a 1-node cluster, so the
# Deployment sticks at 1/2 Available and `helm --wait` times out even though the
# running operator is fully functional. Pin to 1 to match the node count.
operator:
  replicas: 1

ipam:
  mode: cluster-pool
  operator:
    clusterPoolIPv6PodCIDRList:
      - {{ .PodSubnet }}
    # Per-node pod CIDR mask. Cilium's cluster-pool allocator caps the node-CIDR
    # count at 2^16, so (maskSize - poolMask) must be <= 16; the pod pool is a /56,
    # so /64 is the largest (and natural IPv6) per-node size.
    clusterPoolIPv6MaskSize: 64

bpf:
  masquerade: true
enableIPv6Masquerade: true

# Name the devices explicitly instead of letting Cilium auto-detect them, because
# auto-detection races the fabric coming up and silently produces a DIFFERENT answer per
# cluster. Observed: the pools ended up masquerading on [dummy0, apiaddr0, eth1, eth2]
# while the dispatch — bootstrapped first, so its agent started before eth1/eth2 were
# addressed — got only [dummy0, apiaddr0].
#
# The consequence is not a cosmetic difference. With the uplinks missing, pod egress to
# the fabric leaves eth1 UNMASQUERADED, carrying a pod source address the fabric does not
# route back: the ceph node answered such a SYN out its own default route instead of the
# fabric and the connection just hung. That is why the dispatch's ceph-csi could reach no
# mon (`rados: ret=-110, Connection timed out`), which breaks BOTH Volume-image reclaim
# and the Tier-2 storage fence — the csi-addons fence RPC is served from that same pod.
# It went unnoticed because TestTier2Failover is skipped.
#
# The pools masked it twice over: their own flowplane datapath also masquerades pod
# egress, so they would have worked either way.
#
# Wildcards rather than exact names on purpose: apiaddr0 exists only while this node is
# serving the anycast API address, and naming a device that is absent at agent start is
# not worth the risk. `eth+` matches the fabric uplinks (there is no eth0 —
# network-mode: none), and keeping the dummies in the set preserves the
# KubeProxyReplacement/Direct-Routing behaviour the anycast API address relies on.
devices: "eth+,dummy+,apiaddr+"

# Talos runs Cilium in a container-mode node: mount the host cgroup rather than
# letting the agent auto-mount, and grant the capability sets Talos documents.
cgroup:
  autoMount:
    enabled: false
  hostRoot: /sys/fs/cgroup

securityContext:
  capabilities:
    ciliumAgent:
      - CHOWN
      - KILL
      - NET_ADMIN
      - NET_RAW
      - IPC_LOCK
      - SYS_ADMIN
      - SYS_RESOURCE
      - DAC_OVERRIDE
      - FOWNER
      - SETGID
      - SETUID
    cleanCiliumState:
      - NET_ADMIN
      - SYS_ADMIN
      - SYS_RESOURCE
