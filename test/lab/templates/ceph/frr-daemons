# FRR daemons for the ceph sidecar. Adapted from the lean IPv6-fabric switch:
# only zebra + bgpd + bfdd + staticd, which is all an unnumbered-eBGP node needs.
# Everything else stays off.
# NOTE: /etc/frr/daemons is a SHELL file (sourced by frrcommon.sh) — comments MUST
# use '#', not FRR/vtysh '!' (which is a shell syntax error and stops bgpd starting).
zebra=yes
bgpd=yes
bfdd=yes
staticd=yes
ospfd=no
ospf6d=no
ripd=no
ripngd=no
isisd=no
pimd=no
pim6d=no
ldpd=no
nhrpd=no
eigrpd=no
babeld=no
sharpd=no
pbrd=no
bfdd_options="   -A 127.0.0.1"
bgpd_options="   -A 127.0.0.1"
zebra_options="  -A 127.0.0.1 -s 90000000"
staticd_options="-A 127.0.0.1"
vtysh_enable=yes
