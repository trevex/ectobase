---
apiVersion: v1alpha1
kind: BGPPeerConfig
localASN: {{ .ASHost }}
routerID: 10.0.100.{{ .PortSeq }}
routeSource: {{ .IdentityAddr }}
advertise:
  - dummy0   # node identity (/128)
  - vip0     # the API VIP, present only while the local apiserver is healthy
multipath: true
neighbors:
  - link: eth1
    peerASN: {{ .ASSwitch }}
  - link: eth2
    peerASN: {{ .ASSwitch }}
