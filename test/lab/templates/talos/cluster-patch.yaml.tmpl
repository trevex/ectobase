# Per-cluster machine-config patch (talosctl gen config --config-patch). It sets
# the cluster-wide bits; the CNI is resolved to "none" by STRIPPING the
# KubeFlannelCNIConfig doc in talos.Gen — with no CNI doc and no legacy
# .cluster.network block, Talos 1.14 installs no CNI, so the ectobase datapath owns
# pod networking. kube-proxy is disabled (the datapath replaces it).
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
# KubePrism (in-cluster apiserver load-balancer) is enabled by default; pin its port
# so the cluster-wide config-doc is explicit.
apiVersion: v1alpha1
kind: KubePrismConfig
port: 7445
---
# Let a NON-ROOT container open a raw block device it was given.
#
# Without this, CDI cannot populate an RBD-backed VM disk at all. Its importer runs as uid
# 107 with every capability dropped, the device it is handed is /dev/rbd0 (root:disk 0660),
# and it dies before transferring a byte:
#
#   blockdev: cannot open /dev/cdi-block-volume: Permission denied
#     kubevirt.io/containerized-data-importer/pkg/util.GetAvailableSpaceBlock
#
# fsGroup does NOT fix it: Kubernetes applies fsGroup to filesystem volumes, not to raw
# block devices (verified here — a probe pod with fsGroup:107 still saw root:disk and was
# still denied), and ceph-csi does not chown the device either. The runtime is what has to
# do it, and this is the opt-in for that:
# https://kubernetes.io/blog/2021/11/09/non-root-containers-and-devices/
#
# It is OFF by default in containerd and ON by default in CRI-O, which is why this is not a
# well-known problem: CDI's own CI runs CRI-O, so block imports work there and silently
# cannot work on any containerd cluster. The CDI maintainers' answer to exactly this
# failure is this setting — kubevirt/containerized-data-importer#2378.
#
# The plugin key is the containerd 2.x one (we run containerd 2.3.x); 1.x called it
# 'io.containerd.grpc.v1.cri'. Talos restarts CRI by itself when this document changes.
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: device-ownership-from-security-context
content: |
  [plugins]
  [plugins.'io.containerd.cri.v1.runtime']
  device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: KubeNetworkConfig
podSubnets:
  - {{ .PodSubnet }}
serviceSubnets:
  - {{ .SvcSubnet }}
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: {{ .Resolver1 }}
  - address: {{ .Resolver2 }}
---
# etcd runs in-band on the BGP fabric (the underlay), never mgmt: it advertises +
# listens on the node /64, so its member IPs are the node /128 identities. The API
# LB address lives in a different /64 (fd00:cafe:<h>:1::/64), so it never gets picked as an
# etcd peer. max-learners=3 lets the control-plane nodes join etcd as learners
# together — the default single-learner limit deadlocks over the fabric (slower to
# converge than an L2 mgmt net).
cluster:
  etcd:
    advertisedSubnets:
      - {{ .NodeNet64 }}
    extraArgs:
      max-learners: "3"
machine:
  # In-fabric registry for the locally-built :dev app images. `lab up` pushes them
  # into the registry:2 on the WAN segment ({{ .RegistryHost }}); the deploy points
  # every app image at that routable address directly ({{ .RegistryHost }}/trevex/
  # ectobase/<name>:dev via the charts' image values) — NO ghcr.io mirror redirection.
  # (A ghcr.io mirror is the wrong tool: a path-scoped key like ghcr.io/trevex/ectobase
  # produces no containerd hosts.toml at all — config_path is keyed by host only — so
  # it silently does nothing; a bare ghcr.io key would swallow siderolabs/kubelet and
  # 404. Referencing the registry by its own address sidesteps both.) The single
  # config below just marks that host plain-HTTP so containerd speaks h2c to registry:2.
  # Every OTHER image (ghcr.io/siderolabs/kubelet, ghcr.io/k8snetworkplumbingwg/multus,
  # quay.io/docker.io/registry.k8s.io/gcr.io) resolves DIRECTLY upstream over the node's
  # fabric egress (DNS64/NAT64) — not listed here.
  registries:
    mirrors:
      "{{ .RegistryHost }}":
        endpoints:
          - {{ .RegistryEndpoint }}
  # Health-gated anycast API address: a per-node static pod holds the anycast API address on its own apiaddr0
  # dummy only while the local apiserver /healthz returns "ok". Talos' embedded GoBGP
  # advertises apiaddr0 (see the BGPPeerConfig), so an unhealthy node withdraws itself
  # from the anycast set instead of black-holing API traffic.
  pods:
    - apiVersion: v1
      kind: Pod
      metadata:
        name: api-addr
        namespace: kube-system
      spec:
        hostNetwork: true
        containers:
          - name: agent
            image: alpine:3
            securityContext:
              capabilities:
                add: ["NET_ADMIN"]
            command: ["/bin/sh", "-c"]
            # busybox only (no package install): create the apiaddr0 dummy, then hold the
            # LB address on it only while the local apiserver /healthz returns "ok".
            args:
              - |
                ip link add apiaddr0 type dummy 2>/dev/null || true
                ip link set apiaddr0 up
                addr={{ .APIAddr }}/128
                while :; do
                  if wget -q -T2 --no-check-certificate -O- https://127.0.0.1:6443/healthz 2>/dev/null | grep -qx ok; then
                    ip addr add "$addr" dev apiaddr0 2>/dev/null || true
                  else
                    ip addr del "$addr" dev apiaddr0 2>/dev/null || true
                  fi
                  sleep 2
                done
