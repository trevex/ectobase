# Talos image version pin — single source of truth for both variants.
# Bumping this file rebuilds container and vrnetlab.
#
# v1.14.0-beta.0 ships native embedded GoBGP (osrg/gobgp, configured via the
# BGPPeerConfig machine-config document), so no bird/FRR system extension is
# needed for BGP. This is the newest prerelease as of 2026-07-23 (no -rc yet).
TALOS_VERSION=v1.14.0-beta.0
TALOS_IMAGER_IMAGE=ghcr.io/siderolabs/imager:v1.14.0-beta.0
