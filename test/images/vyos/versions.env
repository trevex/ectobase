# amd64 — official VyOS rolling ISO (first-party, signed by VyOS). Rolling
# nightlies get rotated/deleted from the release list over time (the repo
# itself was also renamed vyos-rolling-nightly-builds -> vyos-nightly-build);
# bump this pin periodically to a recent release from that repo's releases
# page. Rolling is >=1.4 "sagitta" (has `set service dns forwarding
# dns64-prefix`), required for the fabric edges' DNS64 forwarder.
VYOS_VERSION=2026.09.01-0034-rolling
VYOS_ARCH=generic-amd64
VYOS_ISO_URL=https://github.com/vyos/vyos-nightly-build/releases/download/2026.09.01-0034-rolling/vyos-2026.09.01-0034-rolling-generic-amd64.iso
