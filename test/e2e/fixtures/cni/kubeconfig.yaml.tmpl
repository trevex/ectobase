# SA-token kubeconfig template for the flowplane CNI plugin (host-netns in-cluster access).
# Extracted from the `cat > "$tmp" <<EOF` heredoc in hack/cni-install.sh — render-equivalent
# (byte-identical after ${API}/${CA_B64}/${TOKEN} substitution).
#
# NOT YET wired into hack/cni-install.sh: that script runs INSIDE the CNI DaemonSet image
# (Dockerfile.cni, debian-slim, ENTRYPOINT /cni-install.sh) and the image does not COPY this
# fixture in. Adopting it needs a `COPY test/e2e/fixtures/cni/kubeconfig.yaml.tmpl /...` in
# Dockerfile.cni, which is out of scope for this change. Staged here for that follow-up.
# envsubst-compatible ${VAR} placeholders.
apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: ${API}
      certificate-authority-data: ${CA_B64}
users:
  - name: cni
    user:
      token: ${TOKEN}
contexts:
  - name: cni
    context: {cluster: local, user: cni}
current-context: cni
