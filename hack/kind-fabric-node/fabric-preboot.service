[Unit]
Description=Fabric preboot: node underlay /64 on dummy0 + kubelet node-ip (before kubelet)
# Order strictly before kubelet so the fabric node-ip is in place when kubelet
# first (and every) starts. Runs after the kindest/node entrypoint has execed
# systemd, so it re-asserts identity on top of anything the entrypoint set.
Before=kubelet.service
DefaultDependencies=no
After=sysinit.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/fabric-preboot.sh

[Install]
WantedBy=multi-user.target
WantedBy=kubelet.service
