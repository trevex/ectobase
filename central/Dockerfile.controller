#
# Minimal runtime image for the central controller. See Dockerfile.apiserver for
# why the binary is built on the host and COPYd in (local `replace` in go.mod).
#
# Expects: a statically linked `central-controller` binary next to this file.
FROM gcr.io/distroless/static:nonroot
COPY central-controller /usr/local/bin/central-controller
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/central-controller"]
